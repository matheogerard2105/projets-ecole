    <datasource caption='Pays × année' inline='true' name='pays_annee' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='pays_annee.csv' name='textscan.pays_annee'>
            <connection class='textscan' directory='/var/folders/5j/7w0kdf314qgf38s5jb4ggv9r0000gn/T/tableau-temp/2408915416/Data/donnees' filename='pays_annee.csv' password='' server='' />
          </named-connection>
        </named-connections>
        <relation connection='textscan.pays_annee' name='pays_annee.csv' table='[pays_annee#csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='fr_FR' separator=','>
            <column datatype='string' name='iso3' ordinal='0' />
            <column datatype='string' name='pays' ordinal='1' />
            <column datatype='string' name='continent' ordinal='2' />
            <column datatype='integer' name='year' ordinal='3' />
            <column datatype='real' name='pop' ordinal='4' />
            <column datatype='real' name='pop_urb' ordinal='5' />
            <column datatype='real' name='pop_rur' ordinal='6' />
            <column datatype='real' name='urban_rate' ordinal='7' />
            <column datatype='real' name='basic_T' ordinal='8' />
            <column datatype='real' name='basic_U' ordinal='9' />
            <column datatype='real' name='basic_R' ordinal='10' />
            <column datatype='real' name='safe_T' ordinal='11' />
            <column datatype='real' name='safe_U' ordinal='12' />
            <column datatype='real' name='safe_R' ordinal='13' />
            <column datatype='real' name='stability' ordinal='14' />
            <column datatype='real' name='pop_without_basic' ordinal='15' />
            <column datatype='real' name='deaths_2016' ordinal='16' />
            <column datatype='real' name='mortality_2016' ordinal='17' />
            <column datatype='real' name='efficiency_score' ordinal='18' />
            <column datatype='real' name='pop_2016' ordinal='19' />
            <column datatype='real' name='stability_2016' ordinal='20' />
            <column datatype='real' name='rang_T' ordinal='21' />
            <column datatype='real' name='rang_U' ordinal='22' />
            <column datatype='real' name='rang_R' ordinal='23' />
            <column datatype='real' name='rang_sans' ordinal='24' />
          </columns>
        </relation>
      </connection>
      <aliases enabled='yes' />
      <column caption='Données migrées' datatype='table' name='[__tableau_internal_object_id__].[Migrated Data]' role='measure' type='quantitative' />
      <column caption='Accès basique (zone)' datatype='real' name='[b_zone]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [zone_code] WHEN &quot;U&quot; THEN [basic_U] WHEN &quot;R&quot; THEN [basic_R] ELSE [basic_T] END' />
      </column>
      <column caption='Accès basique rural' datatype='real' name='[basic_R]' role='measure' type='quantitative' />
      <column caption='Accès basique total' datatype='real' name='[basic_T]' role='measure' type='quantitative' />
      <column caption='Accès basique urbain' datatype='real' name='[basic_U]' role='measure' type='quantitative' />
      <column caption='Classe d&apos;accès basique' datatype='string' name='[classe]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF NOT [f_retenu] THEN &quot;exclu (stabilité)&quot; ELSEIF ISNULL([b_zone]) THEN &quot;n.d.&quot; ELSEIF [b_zone] &lt; 50 THEN &quot;&lt; 50 %&quot; ELSEIF [b_zone] &lt; 70 THEN &quot;50-70 %&quot; ELSEIF [b_zone] &lt; 85 THEN &quot;70-85 %&quot; ELSEIF [b_zone] &lt; 95 THEN &quot;85-95 %&quot; ELSEIF [b_zone] &lt; 99 THEN &quot;95-99 %&quot; ELSE &quot;≥ 99 %&quot; END' />
      </column>
      <column caption='Continent du pays choisi' datatype='string' name='[cont_pays]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{FIXED : MAX(IF [pays] = [Parameters].[Parameter 5] THEN [continent] END)}' />
      </column>
      <column caption='Continent' datatype='string' name='[continent]' role='dimension' type='nominal' />
      <column caption='Décès WASH 2016' datatype='real' name='[deaths_2016]' role='measure' type='quantitative' />
      <column caption='Score d&apos;efficacité' datatype='real' name='[efficiency_score]' role='measure' type='quantitative' />
      <column caption='Année 2016' datatype='boolean' name='[f_2016]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[year] = 2016' />
      </column>
      <column caption='Année choisie' datatype='boolean' name='[f_annee]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[year] = [Parameters].[Parameter 1]' />
      </column>
      <column caption='Dans le continent du pays choisi' datatype='boolean' name='[f_cont_pays]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[continent] = [cont_pays]' />
      </column>
      <column caption='Dans le continent choisi' datatype='boolean' name='[f_continent]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[continent] = [Parameters].[Parameter 4]' />
      </column>
      <column caption='Accès basique renseigné' datatype='boolean' name='[f_has_b]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='NOT ISNULL([b_zone])' />
      </column>
      <column caption='Pays choisi' datatype='boolean' name='[f_pays]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[pays] = [Parameters].[Parameter 5]' />
      </column>
      <column caption='Retenu (stabilité)' datatype='boolean' name='[f_retenu]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='ISNULL([stability]) OR [stability] &gt;= [Parameters].[Parameter 3]' />
      </column>
      <column caption='15 pays les moins équipés' datatype='boolean' name='[f_top15]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[rang_zone] &lt;= 15' />
      </column>
      <column caption='8 pays avec le plus de personnes sans accès' datatype='boolean' name='[f_top8]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[rang_sans] &lt;= 8' />
      </column>
      <column caption='Code pays' datatype='string' name='[iso3]' role='dimension' semantic-role='[Country].[ISO3166_3]' type='nominal' />
      <column caption='KPI Accès basique (détail)' datatype='string' default-role='measure' default-type='ordinal' name='[ks_basic]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;au moins un point d&apos;eau amélioré&quot;' />
      </column>
      <column caption='KPI Mortalité WASH 2016 (détail)' datatype='string' name='[ks_mort]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&quot;pour 100 000 hab. · &quot; + IF ISNULL(SUM([deaths_2016])) THEN &quot;0&quot; ELSEIF SUM([deaths_2016]) &gt;= 1e9 THEN REPLACE(STR(ROUND(SUM([deaths_2016])/1e9, 2)), &quot;.&quot;, &quot;,&quot;) + &quot; Md&quot; ELSEIF SUM([deaths_2016]) &gt;= 1e6 THEN REPLACE(STR(ROUND(SUM([deaths_2016])/1e6, 1)), &quot;.&quot;, &quot;,&quot;) + &quot; M&quot; ELSEIF SUM([deaths_2016]) &gt;= 1e3 THEN STR(INT(ROUND(SUM([deaths_2016])/1e3, 0))) + &quot; k&quot; ELSE STR(INT(ROUND(SUM([deaths_2016]), 0))) END + &quot; décès&quot;' />
      </column>
      <column caption='KPI Population (détail)' datatype='string' name='[ks_pop]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(COUNTD([iso3])) + &quot; pays retenus&quot;' />
      </column>
      <column caption='KPI Accès sûr (détail)' datatype='string' name='[ks_safe]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&quot;données pour &quot; + STR(INT(ROUND([m_safe_cov], 0))) + &quot; % de la population&quot;' />
      </column>
      <column caption='KPI Sans accès basique (détail)' datatype='string' default-role='measure' default-type='ordinal' name='[ks_sans]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;personnes (total)&quot;' />
      </column>
      <column caption='KPI Score d&apos;efficacité 2016 (détail)' datatype='string' default-role='measure' default-type='ordinal' name='[ks_score]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;sur 100 (domaine 3)&quot;' />
      </column>
      <column caption='KPI Stabilité politique (détail)' datatype='string' default-role='measure' default-type='ordinal' name='[ks_stab]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;moyenne des pays, de -2,5 à +2,5&quot;' />
      </column>
      <column caption='KPI Taux d&apos;urbanisation (détail)' datatype='string' default-role='measure' default-type='ordinal' name='[ks_urb]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;population vivant en ville&quot;' />
      </column>
      <column caption='KPI Accès basique' datatype='string' name='[kv_basic]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([m_basic]) THEN &quot;n.d.&quot; ELSE REPLACE(STR(ROUND([m_basic], 1)), &quot;.&quot;, &quot;,&quot;) + &quot; %&quot; END' />
      </column>
      <column caption='KPI Mortalité WASH 2016' datatype='string' name='[kv_mort]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([m_mort]) THEN &quot;n.d.&quot; ELSE REPLACE(STR(ROUND([m_mort], 1)), &quot;.&quot;, &quot;,&quot;) END' />
      </column>
      <column caption='KPI Population' datatype='string' name='[kv_pop]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL(SUM([pop])) THEN &quot;n.d.&quot; ELSEIF SUM([pop]) &gt;= 1e9 THEN REPLACE(STR(ROUND(SUM([pop])/1e9, 2)), &quot;.&quot;, &quot;,&quot;) + &quot; Md&quot; ELSEIF SUM([pop]) &gt;= 1e6 THEN REPLACE(STR(ROUND(SUM([pop])/1e6, 1)), &quot;.&quot;, &quot;,&quot;) + &quot; M&quot; ELSEIF SUM([pop]) &gt;= 1e3 THEN STR(INT(ROUND(SUM([pop])/1e3, 0))) + &quot; k&quot; ELSE STR(INT(ROUND(SUM([pop]), 0))) END' />
      </column>
      <column caption='KPI Accès sûr' datatype='string' name='[kv_safe]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([m_safe]) THEN &quot;n.d.&quot; ELSE REPLACE(STR(ROUND([m_safe], 1)), &quot;.&quot;, &quot;,&quot;) + &quot; %&quot; END' />
      </column>
      <column caption='KPI Sans accès basique' datatype='string' name='[kv_sans]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL(SUM([pop_without_basic])) THEN &quot;n.d.&quot; ELSEIF SUM([pop_without_basic]) &gt;= 1e9 THEN REPLACE(STR(ROUND(SUM([pop_without_basic])/1e9, 2)), &quot;.&quot;, &quot;,&quot;) + &quot; Md&quot; ELSEIF SUM([pop_without_basic]) &gt;= 1e6 THEN REPLACE(STR(ROUND(SUM([pop_without_basic])/1e6, 1)), &quot;.&quot;, &quot;,&quot;) + &quot; M&quot; ELSEIF SUM([pop_without_basic]) &gt;= 1e3 THEN STR(INT(ROUND(SUM([pop_without_basic])/1e3, 0))) + &quot; k&quot; ELSE STR(INT(ROUND(SUM([pop_without_basic]), 0))) END' />
      </column>
      <column caption='KPI Score d&apos;efficacité 2016' datatype='string' name='[kv_score]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL(AVG([efficiency_score])) THEN &quot;n.d.&quot; ELSE REPLACE(STR(ROUND(AVG([efficiency_score]), 0)), &quot;.&quot;, &quot;,&quot;) END' />
      </column>
      <column caption='KPI Stabilité politique' datatype='string' name='[kv_stab]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL(AVG([stability])) THEN &quot;n.d.&quot; ELSE REPLACE(STR(ROUND(AVG([stability]), 2)), &quot;.&quot;, &quot;,&quot;) END' />
      </column>
      <column caption='KPI Taux d&apos;urbanisation' datatype='string' name='[kv_urb]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([m_urb]) THEN &quot;n.d.&quot; ELSE REPLACE(STR(ROUND([m_urb], 1)), &quot;.&quot;, &quot;,&quot;) + &quot; %&quot; END' />
      </column>
      <column caption='Libellé pays choisi' datatype='string' name='[lab_sel]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [f_pays] THEN [pays] END' />
      </column>
      <column caption='% accès basique' datatype='real' name='[m_basic]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF NOT ISNULL([b_zone]) AND NOT ISNULL([w_zone]) THEN [b_zone] * [w_zone] END) / SUM(IF NOT ISNULL([b_zone]) AND NOT ISNULL([w_zone]) THEN [w_zone] END)' />
      </column>
      <column caption='Mortalité WASH 2016 (pour 100 000)' datatype='real' name='[m_mort]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([deaths_2016]) / SUM(IF NOT ISNULL([deaths_2016]) THEN [pop_2016] END) * 100000' />
      </column>
      <column caption='% accès sûr' datatype='real' name='[m_safe]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF NOT ISNULL([s_zone]) AND NOT ISNULL([w_zone]) THEN [s_zone] * [w_zone] END) / SUM(IF NOT ISNULL([s_zone]) AND NOT ISNULL([w_zone]) THEN [w_zone] END)' />
      </column>
      <column caption='Couverture accès sûr' datatype='real' name='[m_safe_cov]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF NOT ISNULL([s_zone]) THEN [pop] END) / SUM([pop]) * 100' />
      </column>
      <column caption='Personnes sans accès basique (millions)' datatype='real' name='[m_sans_M]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([pop_without_basic]) / 1e6' />
      </column>
      <column caption='Taux d&apos;urbanisation' datatype='real' name='[m_urb]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([pop_urb]) / SUM([pop]) * 100' />
      </column>
      <column caption='Mortalité WASH 2016' datatype='real' name='[mortality_2016]' role='measure' type='quantitative' />
      <column caption='Pays' datatype='string' name='[pays]' role='dimension' type='nominal' />
      <column caption='Population' datatype='real' name='[pop]' role='measure' type='quantitative' />
      <column caption='Population 2016' datatype='real' name='[pop_2016]' role='measure' type='quantitative' />
      <column caption='Population rurale' datatype='real' name='[pop_rur]' role='measure' type='quantitative' />
      <column caption='Population urbaine' datatype='real' name='[pop_urb]' role='measure' type='quantitative' />
      <column caption='Personnes sans accès basique' datatype='real' name='[pop_without_basic]' role='measure' type='quantitative' />
      <column caption='Rang d&apos;accès dans le continent' datatype='real' name='[rang_zone]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [zone_code] WHEN &quot;U&quot; THEN [rang_U] WHEN &quot;R&quot; THEN [rang_R] ELSE [rang_T] END' />
      </column>
      <column caption='Accès sûr (zone)' datatype='real' name='[s_zone]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [zone_code] WHEN &quot;U&quot; THEN [safe_U] WHEN &quot;R&quot; THEN [safe_R] ELSE [safe_T] END' />
      </column>
      <column caption='Accès sûr rural' datatype='real' name='[safe_R]' role='measure' type='quantitative' />
      <column caption='Accès sûr total' datatype='real' name='[safe_T]' role='measure' type='quantitative' />
      <column caption='Accès sûr urbain' datatype='real' name='[safe_U]' role='measure' type='quantitative' />
      <column caption='Stabilité politique' datatype='real' name='[stability]' role='measure' type='quantitative' />
      <column caption='Stabilité politique 2016' datatype='real' name='[stability_2016]' role='measure' type='quantitative' />
      <column caption='Taux d&apos;urbanisation' datatype='real' name='[urban_rate]' role='measure' type='quantitative' />
      <column caption='Population de la zone' datatype='real' name='[w_zone]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [zone_code] WHEN &quot;U&quot; THEN [pop_urb] WHEN &quot;R&quot; THEN [pop_rur] ELSE [pop] END' />
      </column>
      <column caption='Année' datatype='integer' name='[year]' role='dimension' type='ordinal' />
      <column caption='Code zone' datatype='string' name='[zone_code]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2] WHEN &quot;Urbain&quot; THEN &quot;U&quot; WHEN &quot;Rural&quot; THEN &quot;R&quot; ELSE &quot;T&quot; END' />
      </column>
