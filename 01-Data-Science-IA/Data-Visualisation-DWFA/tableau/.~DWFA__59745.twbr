      <aliases enabled='yes' />
      <column caption='Données migrées' datatype='table' name='[__tableau_internal_object_id__].[Migrated Data]' role='measure' type='quantitative' />
      <column caption='Continent du pays choisi' datatype='string' name='[cont_pays]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{FIXED : MAX(IF [pays] = [Parameters].[Parameter 5] THEN [continent] END)}' />
      </column>
      <column caption='Continent' datatype='string' name='[continent]' role='dimension' type='nominal' />
      <column caption='Année choisie' datatype='boolean' name='[f_annee]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[year] = [Parameters].[Parameter 1]' />
      </column>
      <column caption='Comparaison pays / continent / monde' datatype='boolean' name='[f_comp]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='([indicateur] = &quot;Urbanisation&quot; OR (([indicateur] = &quot;Accès basique&quot; OR [indicateur] = &quot;Accès sûr&quot;) AND [zone] = [zone_code])) AND (([niveau] = &quot;Pays&quot; AND [f_pays]) OR ([niveau] = &quot;Continent&quot; AND [f_cont_pays] AND [f_retenu]) OR ([niveau] = &quot;Monde&quot; AND [f_retenu]))' />
      </column>
      <column caption='Dans le continent du pays choisi' datatype='boolean' name='[f_cont_pays]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[continent] = [cont_pays]' />
      </column>
      <column caption='Dans le continent choisi' datatype='boolean' name='[f_continent]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[continent] = [Parameters].[Parameter 4]' />
      </column>
      <column caption='Séries de la courbe' datatype='boolean' name='[f_courbe]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[niveau] = &quot;Monde&quot; AND (([indicateur] = &quot;Accès basique&quot;) OR ([indicateur] = &quot;Accès sûr&quot; AND [zone] = &quot;T&quot;))' />
      </column>
      <column caption='Échelle (total, sûr renseigné)' datatype='boolean' name='[f_ech_monde]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[indicateur] = &quot;Échelle&quot; AND [zone] = &quot;T&quot; AND [sur_renseigne]' />
      </column>
      <column caption='Échelle (zone choisie)' datatype='boolean' name='[f_ech_zone]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[indicateur] = &quot;Échelle&quot; AND [zone] = [zone_code]' />
      </column>
      <column caption='Niveau Monde' datatype='boolean' name='[f_monde]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[niveau] = &quot;Monde&quot;' />
      </column>
      <column caption='Panel accès sûr (si série sûre)' datatype='boolean' name='[f_panel]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[indicateur] &lt;&gt; &quot;Accès sûr&quot; OR [panel_sur]' />
      </column>
      <column caption='Pays choisi' datatype='boolean' name='[f_pays]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[pays] = [Parameters].[Parameter 5]' />
      </column>
      <column caption='Population urbaine / rurale' datatype='boolean' name='[f_pop]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[indicateur] = &quot;Population&quot;' />
      </column>
      <column caption='Retenu (stabilité)' datatype='boolean' name='[f_retenu]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='ISNULL([stability]) OR [stability] &gt;= [Parameters].[Parameter 3]' />
      </column>
      <column caption='Stabilité pays / continent' datatype='boolean' name='[f_stab]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[indicateur] = &quot;Stabilité&quot; AND (([niveau] = &quot;Pays&quot; AND [f_pays]) OR ([niveau] = &quot;Continent&quot; AND [f_cont_pays]))' />
      </column>
      <column caption='15 pays les moins équipés' datatype='boolean' name='[f_top15]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[rang_zone] &lt;= 15' />
      </column>
      <column caption='Accès basique urbain / rural' datatype='boolean' name='[f_vc]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[niveau] = &quot;Monde&quot; AND [indicateur] = &quot;Accès basique&quot; AND [zone] &lt;&gt; &quot;T&quot;' />
      </column>
      <column caption='Indicateur' datatype='string' name='[indicateur]' role='dimension' type='nominal' />
      <column caption='Code pays' datatype='string' name='[iso3]' role='dimension' semantic-role='[Country].[ISO3166_3]' type='nominal' />
      <column caption='Pays / continent / monde' datatype='string' name='[lib_niveau]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [niveau] WHEN &quot;Pays&quot; THEN [Parameters].[Parameter 5] WHEN &quot;Continent&quot; THEN [cont_pays] ELSE &quot;Monde&quot; END' />
      </column>
      <column caption='Milieu' datatype='string' name='[lib_vc]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [zone] = &quot;U&quot; THEN &quot;Urbain&quot; ELSE &quot;Rural&quot; END' />
      </column>
      <column caption='Série' datatype='string' name='[libelle]' role='dimension' type='nominal' />
      <column caption='Valeur (somme)' datatype='real' name='[m_sum]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([valeur])' />
      </column>
      <column caption='Valeur pondérée' datatype='real' name='[m_val]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF NOT ISNULL([valeur]) AND NOT ISNULL([poids]) THEN [valeur] * [poids] END) / SUM(IF NOT ISNULL([valeur]) AND NOT ISNULL([poids]) THEN [poids] END)' />
      </column>
      <column caption='Niveau' datatype='string' name='[niveau]' role='dimension' type='nominal' />
      <column caption='Panel accès sûr' datatype='boolean' name='[panel_sur]' role='dimension' type='nominal' />
      <column caption='Pays' datatype='string' name='[pays]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column caption='Poids' datatype='real' name='[poids]' role='measure' type='quantitative' />
      <column caption='Rang d&apos;accès dans le continent' datatype='real' name='[rang_zone]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [zone_code] WHEN &quot;U&quot; THEN [rang_U] WHEN &quot;R&quot; THEN [rang_R] ELSE [rang_T] END' />
      </column>
      <column caption='Stabilité politique' datatype='real' name='[stability]' role='measure' type='quantitative' />
      <column caption='Accès sûr renseigné' datatype='boolean' name='[sur_renseigne]' role='dimension' type='nominal' />
      <column caption='Valeur' datatype='real' name='[valeur]' role='measure' type='quantitative' />
      <column caption='Année' datatype='integer' name='[year]' role='dimension' type='ordinal' />
      <column caption='Zone' datatype='string' name='[zone]' role='dimension' type='nominal' />
      <column caption='Code zone' datatype='string' name='[zone_code]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2] WHEN &quot;Urbain&quot; THEN &quot;U&quot; WHEN &quot;Rural&quot; THEN &quot;R&quot; ELSE &quot;T&quot; END' />
      </column>
