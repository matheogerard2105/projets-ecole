              <format attr='background-color' value='#ffffff' />
            </zone-style>
          </zone>
          <zone h='5319' id='15' name='Monde · KPI Population' show-title='false' w='14286' x='0' y='7979' />
          <zone h='5319' id='16' name='Monde · KPI Accès basique' show-title='false' w='14286' x='14286' y='7979' />
          <zone h='5319' id='17' name='Monde · KPI Accès sûr' show-title='false' w='14286' x='28571' y='7979' />
