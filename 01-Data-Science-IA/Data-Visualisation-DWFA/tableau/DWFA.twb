            <column-instance column="[f_pays]" derivation='None' name="[none:f_pays:nk]" pivot='key' type='nominal' />
            <column-instance column="[ks_urb]" derivation='User' name="[usr:ks_urb:nk]" pivot='key' type='nominal' />
            <column-instance column="[kv_urb]" derivation='User' name="[usr:kv_urb:nk]" pivot='key' type='nominal' />
          </datasource-dependencies>
