                <member value='"Éthiopie"' />
                <member value='"Îles Cook"' />
                <member value='"Îles Marshall"' />
              </members>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource="indicateurs">
            <column caption="Pays choisi" datatype='boolean' name="[f_pays]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="[pays] = [Parameters].[Parameter 5]" />
            </column>
            <column caption="Population urbaine / rurale" datatype='boolean' name="[f_pop]" role='dimension' type='nominal'>
              <calculation class='tableau' formula='[indicateur] = "Population"' />
            </column>
            <column caption="Indicateur" datatype='string' name="[indicateur]" role='dimension' type='nominal' />
            <column caption="Série" datatype='string' name="[libelle]" role='dimension' type='nominal' />
            <column caption="Valeur (somme)" datatype='real' name="[m_sum]" role='measure' type='quantitative'>
              <calculation class='tableau' formula="SUM([valeur])" />
            </column>
            <column caption="Pays" datatype='string' name="[pays]" role='dimension' type='nominal' />
            <column caption="Valeur" datatype='real' name="[valeur]" role='measure' type='quantitative' />
            <column caption="Année" datatype='integer' name="[year]" role='dimension' type='ordinal' />
            <column-instance column="[f_pays]" derivation='None' name="[none:f_pays:nk]" pivot='key' type='nominal' />
            <column-instance column="[f_pop]" derivation='None' name="[none:f_pop:nk]" pivot='key' type='nominal' />
            <column-instance column="[libelle]" derivation='None' name="[none:libelle:nk]" pivot='key' type='nominal' />
            <column-instance column="[year]" derivation='None' name="[none:year:ok]" pivot='key' type='ordinal' />
            <column-instance column="[m_sum]" derivation='User' name="[usr:m_sum:qk]" pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column="[indicateurs].[none:f_pop:nk]">
            <groupfilter function='member' level="[none:f_pop:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column="[indicateurs].[none:f_pays:nk]">
            <groupfilter function='member' level="[none:f_pays:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[indicateurs].[none:f_pop:nk]</column>
            <column>[indicateurs].[none:f_pays:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='title' class='0' field="[indicateurs].[usr:m_sum:qk]" scope='rows' value="millions d'habitants" />
          </style-rule>
        </style>
        <panes>
          <pane>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column="[indicateurs].[none:libelle:nk]" />
            </encodings>
            <style>
              <style-rule element='mark'>
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[indicateurs].[usr:m_sum:qk]</rows>
        <cols>[indicateurs].[none:year:ok]</cols>
      </table>
    </worksheet>
