      <aliases enabled='yes' />
      <column caption="Code pays" datatype='string' name="[iso3]" role='dimension' type='nominal' semantic-role='[Country].[ISO3166_3]' />
      <column caption="Pays" datatype='string' name="[pays]" role='dimension' type='nominal' />
      <column caption="Continent" datatype='string' name="[continent]" role='dimension' type='nominal' />
      <column caption="Année" datatype='integer' name="[year]" role='dimension' type='ordinal' />
      <column caption="Stabilité politique" datatype='real' name="[stability]" role='measure' type='quantitative' />
      <column datatype='real' name="[rang_T]" role='measure' type='quantitative' />
      <column datatype='real' name="[rang_U]" role='measure' type='quantitative' />
      <column datatype='real' name="[rang_R]" role='measure' type='quantitative' />
      <column caption="Panel accès sûr" datatype='boolean' name="[panel_sur]" role='dimension' type='nominal' />
      <column caption="Niveau" datatype='string' name="[niveau]" role='dimension' type='nominal' />
      <column caption="Indicateur" datatype='string' name="[indicateur]" role='dimension' type='nominal' />
      <column caption="Zone" datatype='string' name="[zone]" role='dimension' type='nominal' />
      <column caption="Série" datatype='string' name="[libelle]" role='dimension' type='nominal' />
      <column caption="Valeur" datatype='real' name="[valeur]" role='measure' type='quantitative' />
      <column caption="Poids" datatype='real' name="[poids]" role='measure' type='quantitative' />
      <column caption="Accès sûr renseigné" datatype='boolean' name="[sur_renseigne]" role='dimension' type='nominal' />
      <column caption="Retenu (stabilité)" datatype='boolean' name="[f_retenu]" role='dimension' type='nominal'>
        <calculation class='tableau' formula="ISNULL([stability]) OR [stability] &gt;= [Parameters].[Parameter 3]" />
      </column>
      <column caption="Année choisie" datatype='boolean' name="[f_annee]" role='dimension' type='nominal'>
        <calculation class='tableau' formula="[year] = [Parameters].[Parameter 1]" />
      </column>
      <column caption="Dans le continent choisi" datatype='boolean' name="[f_continent]" role='dimension' type='nominal'>
        <calculation class='tableau' formula="[continent] = [Parameters].[Parameter 4]" />
      </column>
      <column caption="Pays choisi" datatype='boolean' name="[f_pays]" role='dimension' type='nominal'>
        <calculation class='tableau' formula="[pays] = [Parameters].[Parameter 5]" />
      </column>
      <column caption="Continent du pays choisi" datatype='string' name="[cont_pays]" role='dimension' type='nominal'>
        <calculation class='tableau' formula="{FIXED : MAX(IF [pays] = [Parameters].[Parameter 5] THEN [continent] END)}" />
      </column>
      <column caption="Dans le continent du pays choisi" datatype='boolean' name="[f_cont_pays]" role='dimension' type='nominal'>
        <calculation class='tableau' formula="[continent] = [cont_pays]" />
      </column>
      <column caption="Code zone" datatype='string' name="[zone_code]" role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2] WHEN "Urbain" THEN "U" WHEN "Rural" THEN "R" ELSE "T" END' />
      </column>
      <column caption="Rang d'accès dans le continent" datatype='real' name="[rang_zone]" role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [zone_code] WHEN "U" THEN [rang_U] WHEN "R" THEN [rang_R] ELSE [rang_T] END' />
      </column>
      <column caption="15 pays les moins équipés" datatype='boolean' name="[f_top15]" role='dimension' type='nominal'>
        <calculation class='tableau' formula="[rang_zone] &lt;= 15" />
      </column>
      <column caption="Valeur pondérée" datatype='real' name="[m_val]" role='measure' type='quantitative'>
        <calculation class='tableau' formula="SUM(IF NOT ISNULL([valeur]) AND NOT ISNULL([poids]) THEN [valeur] * [poids] END) / SUM(IF NOT ISNULL([valeur]) AND NOT ISNULL([poids]) THEN [poids] END)" />
      </column>
      <column caption="Valeur (somme)" datatype='real' name="[m_sum]" role='measure' type='quantitative'>
        <calculation class='tableau' formula="SUM([valeur])" />
      </column>
      <column caption="Niveau Monde" datatype='boolean' name="[f_monde]" role='dimension' type='nominal'>
        <calculation class='tableau' formula='[niveau] = "Monde"' />
      </column>
      <column caption="Séries de la courbe" datatype='boolean' name="[f_courbe]" role='dimension' type='nominal'>
        <calculation class='tableau' formula='[niveau] = "Monde" AND (([indicateur] = "Accès basique") OR ([indicateur] = "Accès sûr" AND [zone] = "T"))' />
      </column>
      <column caption="Panel accès sûr (si série sûre)" datatype='boolean' name="[f_panel]" role='dimension' type='nominal'>
        <calculation class='tableau' formula='[indicateur] &lt;&gt; "Accès sûr" OR [panel_sur]' />
      </column>
      <column caption="Accès basique urbain / rural" datatype='boolean' name="[f_vc]" role='dimension' type='nominal'>
        <calculation class='tableau' formula='[niveau] = "Monde" AND [indicateur] = "Accès basique" AND [zone] &lt;&gt; "T"' />
      </column>
      <column caption="Échelle (total, sûr renseigné)" datatype='boolean' name="[f_ech_monde]" role='dimension' type='nominal'>
        <calculation class='tableau' formula='[indicateur] = "Échelle" AND [zone] = "T" AND [sur_renseigne]' />
      </column>
      <column caption="Échelle (zone choisie)" datatype='boolean' name="[f_ech_zone]" role='dimension' type='nominal'>
        <calculation class='tableau' formula='[indicateur] = "Échelle" AND [zone] = [zone_code]' />
      </column>
      <column caption="Population urbaine / rurale" datatype='boolean' name="[f_pop]" role='dimension' type='nominal'>
        <calculation class='tableau' formula='[indicateur] = "Population"' />
      </column>
      <column caption="Comparaison pays / continent / monde" datatype='boolean' name="[f_comp]" role='dimension' type='nominal'>
        <calculation class='tableau' formula='([indicateur] = "Urbanisation" OR (([indicateur] = "Accès basique" OR [indicateur] = "Accès sûr") AND [zone] = [zone_code])) AND (([niveau] = "Pays" AND [f_pays]) OR ([niveau] = "Continent" AND [f_cont_pays] AND [f_retenu]) OR ([niveau] = "Monde" AND [f_retenu]))' />
      </column>
      <column caption="Stabilité pays / continent" datatype='boolean' name="[f_stab]" role='dimension' type='nominal'>
        <calculation class='tableau' formula='[indicateur] = "Stabilité" AND (([niveau] = "Pays" AND [f_pays]) OR ([niveau] = "Continent" AND [f_cont_pays]))' />
      </column>
      <column caption="Pays / continent / monde" datatype='string' name="[lib_niveau]" role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [niveau] WHEN "Pays" THEN [Parameters].[Parameter 5] WHEN "Continent" THEN [cont_pays] ELSE "Monde" END' />
      </column>
      <column caption="Milieu" datatype='string' name="[lib_vc]" role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [zone] = "U" THEN "Urbain" ELSE "Rural" END' />
      </column>
      <style>
        <style-rule element='mark'>
          <encoding attr='color' field="[none:libelle:nk]" type='palette'>
            <map to='#1c5cab'>
              <bucket>"Accès basique · total"</bucket>
            </map>
            <map to='#0d366b'>
              <bucket>"Accès basique · urbain"</bucket>
            </map>
            <map to='#6da7ec'>
              <bucket>"Accès basique · rural"</bucket>
            </map>
            <map to='#e08a2c'>
              <bucket>"Accès sûr · total"</bucket>
            </map>
            <map to='#104281'>
              <bucket>"Accès sûr"</bucket>
            </map>
            <map to='#5598e7'>
              <bucket>"Basique, non sûr"</bucket>
            </map>
            <map to='#cde2fb'>
              <bucket>"Sans accès basique"</bucket>
            </map>
            <map to='#0d366b'>
              <bucket>"Urbaine"</bucket>
            </map>
            <map to='#6da7ec'>
              <bucket>"Rurale"</bucket>
            </map>
          </encoding>
          <encoding attr='color' field="[none:lib_vc:nk]" type='palette'>
            <map to='#0d366b'>
              <bucket>"Urbain"</bucket>
            </map>
            <map to='#6da7ec'>
              <bucket>"Rural"</bucket>
            </map>
          </encoding>
          <encoding attr='color' field="[none:niveau:nk]" type='palette'>
            <map to='#0d366b'>
              <bucket>"Pays"</bucket>
            </map>
            <map to='#5598e7'>
              <bucket>"Continent"</bucket>
            </map>
            <map to='#b7d3f6'>
              <bucket>"Monde"</bucket>
            </map>
          </encoding>
        </style-rule>
      </style>
    </datasource>
  </datasources>
  <mapsources>
    <mapsource name='Tableau' />
  </mapsources>
  <worksheets>
    <worksheet name="Monde · KPI Population">
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#0b2236' fontsize='11'>Population</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Pays × année" name="pays_annee" />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption="Année" datatype='integer' name="[Parameter 1]" param-domain-type='range' role='measure' type='quantitative' value="2017">
              <calculation class='tableau' formula="2017" />
              <range granularity='1' max='2017' min='2000' />
            </column>
            <column caption="Stabilité politique minimale" datatype='real' name="[Parameter 3]" param-domain-type='range' role='measure' type='quantitative' value="-3.5">
              <calculation class='tableau' formula="-3.5" />
              <range granularity='0.1' max='1.5' min='-3.5' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource="pays_annee">
            <column caption="Année choisie" datatype='boolean' name="[f_annee]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="[year] = [Parameters].[Parameter 1]" />
            </column>
            <column caption="Retenu (stabilité)" datatype='boolean' name="[f_retenu]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="ISNULL([stability]) OR [stability] &gt;= [Parameters].[Parameter 3]" />
            </column>
            <column caption="Code pays" datatype='string' name="[iso3]" role='dimension' type='nominal' semantic-role='[Country].[ISO3166_3]' />
            <column caption="KPI Population (détail)" datatype='string' name="[ks_pop]" role='measure' type='nominal'>
              <calculation class='tableau' formula='STR(COUNTD([iso3])) + " pays retenus"' />
            </column>
            <column caption="KPI Population" datatype='string' name="[kv_pop]" role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL(SUM([pop])) THEN "n.d." ELSEIF SUM([pop]) &gt;= 1e9 THEN REPLACE(STR(ROUND(SUM([pop])/1e9, 2)), ".", ",") + " Md" ELSEIF SUM([pop]) &gt;= 1e6 THEN REPLACE(STR(ROUND(SUM([pop])/1e6, 1)), ".", ",") + " M" ELSEIF SUM([pop]) &gt;= 1e3 THEN STR(INT(ROUND(SUM([pop])/1e3, 0))) + " k" ELSE STR(INT(ROUND(SUM([pop]), 0))) END' />
            </column>
            <column caption="Population" datatype='real' name="[pop]" role='measure' type='quantitative' />
            <column caption="Stabilité politique" datatype='real' name="[stability]" role='measure' type='quantitative' />
            <column caption="Année" datatype='integer' name="[year]" role='dimension' type='ordinal' />
            <column-instance column="[f_annee]" derivation='None' name="[none:f_annee:nk]" pivot='key' type='nominal' />
            <column-instance column="[f_retenu]" derivation='None' name="[none:f_retenu:nk]" pivot='key' type='nominal' />
            <column-instance column="[ks_pop]" derivation='User' name="[usr:ks_pop:nk]" pivot='key' type='nominal' />
            <column-instance column="[kv_pop]" derivation='User' name="[usr:kv_pop:nk]" pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column="[pays_annee].[none:f_annee:nk]">
            <groupfilter function='member' level="[none:f_annee:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column="[pays_annee].[none:f_retenu:nk]">
            <groupfilter function='member' level="[none:f_retenu:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[pays_annee].[none:f_annee:nk]</column>
            <column>[pays_annee].[none:f_retenu:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
        </style>
        <panes>
          <pane>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Text' />
            <encodings>
              <text column="[pays_annee].[usr:kv_pop:nk]" />
              <tooltip column="[pays_annee].[usr:ks_pop:nk]" />
            </encodings>
            <customized-label>
              <formatted-text>
                <run fontcolor='#5f7488' fontsize='9' bold='true'>POPULATION
</run>
                <run fontcolor='#0b2236' fontsize='20' bold='true'>&lt;[pays_annee].[usr:kv_pop:nk]&gt;
</run>
                <run fontcolor='#5f7488' fontsize='8'>&lt;[pays_annee].[usr:ks_pop:nk]&gt;</run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows></rows>
        <cols></cols>
      </table>
    </worksheet>
    <worksheet name="Monde · KPI Accès basique">
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#0b2236' fontsize='11'>Accès basique</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Pays × année" name="pays_annee" />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption="Année" datatype='integer' name="[Parameter 1]" param-domain-type='range' role='measure' type='quantitative' value="2017">
              <calculation class='tableau' formula="2017" />
              <range granularity='1' max='2017' min='2000' />
            </column>
            <column caption="Zone" datatype='string' name="[Parameter 2]" param-domain-type='list' role='measure' type='nominal' value='"Total"'>
              <calculation class='tableau' formula='"Total"' />
              <members>
                <member value='"Total"' />
                <member value='"Urbain"' />
                <member value='"Rural"' />
              </members>
            </column>
            <column caption="Stabilité politique minimale" datatype='real' name="[Parameter 3]" param-domain-type='range' role='measure' type='quantitative' value="-3.5">
              <calculation class='tableau' formula="-3.5" />
              <range granularity='0.1' max='1.5' min='-3.5' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource="pays_annee">
            <column caption="Accès basique (zone)" datatype='real' name="[b_zone]" role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [zone_code] WHEN "U" THEN [basic_U] WHEN "R" THEN [basic_R] ELSE [basic_T] END' />
            </column>
            <column caption="Accès basique rural" datatype='real' name="[basic_R]" role='measure' type='quantitative' />
            <column caption="Accès basique total" datatype='real' name="[basic_T]" role='measure' type='quantitative' />
            <column caption="Accès basique urbain" datatype='real' name="[basic_U]" role='measure' type='quantitative' />
            <column caption="Année choisie" datatype='boolean' name="[f_annee]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="[year] = [Parameters].[Parameter 1]" />
            </column>
            <column caption="Retenu (stabilité)" datatype='boolean' name="[f_retenu]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="ISNULL([stability]) OR [stability] &gt;= [Parameters].[Parameter 3]" />
            </column>
            <column caption="Code pays" datatype='string' name="[iso3]" role='dimension' type='nominal' semantic-role='[Country].[ISO3166_3]' />
            <column caption="KPI Accès basique (détail)" datatype='string' name="[ks_basic]" role='measure' type='nominal'>
              <calculation class='tableau' formula="IF COUNT([iso3]) &gt; 0 THEN &quot;au moins un point d'eau amélioré&quot; END" />
            </column>
            <column caption="KPI Accès basique" datatype='string' name="[kv_basic]" role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([m_basic]) THEN "n.d." ELSE REPLACE(STR(ROUND([m_basic], 1)), ".", ",") + " %" END' />
            </column>
            <column caption="% accès basique" datatype='real' name="[m_basic]" role='measure' type='quantitative'>
              <calculation class='tableau' formula="SUM(IF NOT ISNULL([b_zone]) AND NOT ISNULL([w_zone]) THEN [b_zone] * [w_zone] END) / SUM(IF NOT ISNULL([b_zone]) AND NOT ISNULL([w_zone]) THEN [w_zone] END)" />
            </column>
            <column caption="Population" datatype='real' name="[pop]" role='measure' type='quantitative' />
            <column caption="Population rurale" datatype='real' name="[pop_rur]" role='measure' type='quantitative' />
            <column caption="Population urbaine" datatype='real' name="[pop_urb]" role='measure' type='quantitative' />
            <column caption="Stabilité politique" datatype='real' name="[stability]" role='measure' type='quantitative' />
            <column caption="Population de la zone" datatype='real' name="[w_zone]" role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [zone_code] WHEN "U" THEN [pop_urb] WHEN "R" THEN [pop_rur] ELSE [pop] END' />
            </column>
            <column caption="Année" datatype='integer' name="[year]" role='dimension' type='ordinal' />
            <column caption="Code zone" datatype='string' name="[zone_code]" role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2] WHEN "Urbain" THEN "U" WHEN "Rural" THEN "R" ELSE "T" END' />
            </column>
            <column-instance column="[f_annee]" derivation='None' name="[none:f_annee:nk]" pivot='key' type='nominal' />
            <column-instance column="[f_retenu]" derivation='None' name="[none:f_retenu:nk]" pivot='key' type='nominal' />
            <column-instance column="[ks_basic]" derivation='User' name="[usr:ks_basic:nk]" pivot='key' type='nominal' />
            <column-instance column="[kv_basic]" derivation='User' name="[usr:kv_basic:nk]" pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column="[pays_annee].[none:f_annee:nk]">
