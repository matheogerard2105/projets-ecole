    <worksheet name="Monde · KPI Accès sûr">
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#0b2236' fontsize='11'>Accès sûr</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Pays × année" name="pays_annee" />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption="Année" datatype='integer' name="[Parameter 1]" param-domain-type='range' role='measure' type='quantitative' value="2017">
              <calculation class='tableau' formula="2017" />
              <range granularity='1' max='2017' min='2000' />
            </column>
            <column caption="Zone" datatype='string' name="[Parameter 2]" param-domain-type='list' role='measure' type='nominal' value='"Total"'>
              <calculation class='tableau' formula='"Total"' />
              <members>
                <member value='"Total"' />
                <member value='"Urbain"' />
                <member value='"Rural"' />
              </members>
            </column>
            <column caption="Stabilité politique minimale" datatype='real' name="[Parameter 3]" param-domain-type='range' role='measure' type='quantitative' value="-3.5">
              <calculation class='tableau' formula="-3.5" />
              <range granularity='0.1' max='1.5' min='-3.5' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource="pays_annee">
            <column caption="Année choisie" datatype='boolean' name="[f_annee]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="[year] = [Parameters].[Parameter 1]" />
            </column>
            <column caption="Retenu (stabilité)" datatype='boolean' name="[f_retenu]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="ISNULL([stability]) OR [stability] &gt;= [Parameters].[Parameter 3]" />
            </column>
            <column caption="KPI Accès sûr (détail)" datatype='string' name="[ks_safe]" role='measure' type='nominal'>
              <calculation class='tableau' formula='"données pour " + STR(INT(ROUND([m_safe_cov], 0))) + " % de la population"' />
            </column>
            <column caption="KPI Accès sûr" datatype='string' name="[kv_safe]" role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([m_safe]) THEN "n.d." ELSE REPLACE(STR(ROUND([m_safe], 1)), ".", ",") + " %" END' />
            </column>
            <column caption="% accès sûr" datatype='real' name="[m_safe]" role='measure' type='quantitative'>
              <calculation class='tableau' formula="SUM(IF NOT ISNULL([s_zone]) AND NOT ISNULL([w_zone]) THEN [s_zone] * [w_zone] END) / SUM(IF NOT ISNULL([s_zone]) AND NOT ISNULL([w_zone]) THEN [w_zone] END)" />
            </column>
            <column caption="Couverture accès sûr" datatype='real' name="[m_safe_cov]" role='measure' type='quantitative'>
              <calculation class='tableau' formula="SUM(IF NOT ISNULL([s_zone]) THEN [pop] END) / SUM([pop]) * 100" />
            </column>
            <column caption="Population" datatype='real' name="[pop]" role='measure' type='quantitative' />
            <column caption="Population rurale" datatype='real' name="[pop_rur]" role='measure' type='quantitative' />
            <column caption="Population urbaine" datatype='real' name="[pop_urb]" role='measure' type='quantitative' />
            <column caption="Accès sûr (zone)" datatype='real' name="[s_zone]" role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [zone_code] WHEN "U" THEN [safe_U] WHEN "R" THEN [safe_R] ELSE [safe_T] END' />
            </column>
            <column caption="Accès sûr rural" datatype='real' name="[safe_R]" role='measure' type='quantitative' />
            <column caption="Accès sûr total" datatype='real' name="[safe_T]" role='measure' type='quantitative' />
            <column caption="Accès sûr urbain" datatype='real' name="[safe_U]" role='measure' type='quantitative' />
            <column caption="Stabilité politique" datatype='real' name="[stability]" role='measure' type='quantitative' />
            <column caption="Population de la zone" datatype='real' name="[w_zone]" role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [zone_code] WHEN "U" THEN [pop_urb] WHEN "R" THEN [pop_rur] ELSE [pop] END' />
            </column>
            <column caption="Année" datatype='integer' name="[year]" role='dimension' type='ordinal' />
            <column caption="Code zone" datatype='string' name="[zone_code]" role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2] WHEN "Urbain" THEN "U" WHEN "Rural" THEN "R" ELSE "T" END' />
            </column>
            <column-instance column="[f_annee]" derivation='None' name="[none:f_annee:nk]" pivot='key' type='nominal' />
            <column-instance column="[f_retenu]" derivation='None' name="[none:f_retenu:nk]" pivot='key' type='nominal' />
            <column-instance column="[ks_safe]" derivation='User' name="[usr:ks_safe:nk]" pivot='key' type='nominal' />
            <column-instance column="[kv_safe]" derivation='User' name="[usr:kv_safe:nk]" pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column="[pays_annee].[none:f_annee:nk]">
            <groupfilter function='member' level="[none:f_annee:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column="[pays_annee].[none:f_retenu:nk]">
            <groupfilter function='member' level="[none:f_retenu:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[pays_annee].[none:f_annee:nk]</column>
            <column>[pays_annee].[none:f_retenu:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
        </style>
        <panes>
          <pane>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Text' />
            <encodings>
              <text column="[pays_annee].[usr:kv_safe:nk]" />
              <tooltip column="[pays_annee].[usr:ks_safe:nk]" />
            </encodings>
            <customized-label>
              <formatted-text>
                <run fontcolor='#5f7488' fontsize='9' bold='true'>ACCÈS SÛR
</run>
                <run fontcolor='#0b2236' fontsize='20' bold='true'>&lt;[pays_annee].[usr:kv_safe:nk]&gt;
</run>
                <run fontcolor='#5f7488' fontsize='8'>&lt;[pays_annee].[usr:ks_safe:nk]&gt;</run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows></rows>
        <cols></cols>
      </table>
    </worksheet>
    <worksheet name="Monde · KPI Sans accès basique">
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#0b2236' fontsize='11'>Sans accès basique</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Pays × année" name="pays_annee" />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption="Année" datatype='integer' name="[Parameter 1]" param-domain-type='range' role='measure' type='quantitative' value="2017">
              <calculation class='tableau' formula="2017" />
              <range granularity='1' max='2017' min='2000' />
            </column>
            <column caption="Stabilité politique minimale" datatype='real' name="[Parameter 3]" param-domain-type='range' role='measure' type='quantitative' value="-3.5">
              <calculation class='tableau' formula="-3.5" />
              <range granularity='0.1' max='1.5' min='-3.5' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource="pays_annee">
            <column caption="Année choisie" datatype='boolean' name="[f_annee]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="[year] = [Parameters].[Parameter 1]" />
            </column>
            <column caption="Retenu (stabilité)" datatype='boolean' name="[f_retenu]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="ISNULL([stability]) OR [stability] &gt;= [Parameters].[Parameter 3]" />
            </column>
            <column caption="Code pays" datatype='string' name="[iso3]" role='dimension' type='nominal' semantic-role='[Country].[ISO3166_3]' />
            <column caption="KPI Sans accès basique (détail)" datatype='string' name="[ks_sans]" role='measure' type='nominal'>
              <calculation class='tableau' formula='IF COUNT([iso3]) &gt; 0 THEN "personnes (total)" END' />
            </column>
            <column caption="KPI Sans accès basique" datatype='string' name="[kv_sans]" role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL(SUM([pop_without_basic])) THEN "n.d." ELSEIF SUM([pop_without_basic]) &gt;= 1e9 THEN REPLACE(STR(ROUND(SUM([pop_without_basic])/1e9, 2)), ".", ",") + " Md" ELSEIF SUM([pop_without_basic]) &gt;= 1e6 THEN REPLACE(STR(ROUND(SUM([pop_without_basic])/1e6, 1)), ".", ",") + " M" ELSEIF SUM([pop_without_basic]) &gt;= 1e3 THEN STR(INT(ROUND(SUM([pop_without_basic])/1e3, 0))) + " k" ELSE STR(INT(ROUND(SUM([pop_without_basic]), 0))) END' />
            </column>
            <column caption="Personnes sans accès basique" datatype='real' name="[pop_without_basic]" role='measure' type='quantitative' />
            <column caption="Stabilité politique" datatype='real' name="[stability]" role='measure' type='quantitative' />
            <column caption="Année" datatype='integer' name="[year]" role='dimension' type='ordinal' />
            <column-instance column="[f_annee]" derivation='None' name="[none:f_annee:nk]" pivot='key' type='nominal' />
            <column-instance column="[f_retenu]" derivation='None' name="[none:f_retenu:nk]" pivot='key' type='nominal' />
            <column-instance column="[ks_sans]" derivation='User' name="[usr:ks_sans:nk]" pivot='key' type='nominal' />
            <column-instance column="[kv_sans]" derivation='User' name="[usr:kv_sans:nk]" pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column="[pays_annee].[none:f_annee:nk]">
            <groupfilter function='member' level="[none:f_annee:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column="[pays_annee].[none:f_retenu:nk]">
            <groupfilter function='member' level="[none:f_retenu:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[pays_annee].[none:f_annee:nk]</column>
            <column>[pays_annee].[none:f_retenu:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
        </style>
        <panes>
          <pane>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Text' />
            <encodings>
              <text column="[pays_annee].[usr:kv_sans:nk]" />
              <tooltip column="[pays_annee].[usr:ks_sans:nk]" />
            </encodings>
            <customized-label>
              <formatted-text>
                <run fontcolor='#5f7488' fontsize='9' bold='true'>SANS ACCÈS BASIQUE
</run>
                <run fontcolor='#0b2236' fontsize='20' bold='true'>&lt;[pays_annee].[usr:kv_sans:nk]&gt;
</run>
                <run fontcolor='#5f7488' fontsize='8'>&lt;[pays_annee].[usr:ks_sans:nk]&gt;</run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows></rows>
        <cols></cols>
      </table>
