            </column>
            <column caption="KPI Accès sûr (détail)" datatype='string' name="[ks_safe]" role='measure' type='nominal'>
              <calculation class='tableau' formula='"données pour " + STR(INT(ROUND([m_safe_cov], 0))) + " % de la population"' />
            </column>
            <column caption="KPI Accès sûr" datatype='string' name="[kv_safe]" role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([m_safe]) THEN "n.d." ELSE REPLACE(STR(ROUND([m_safe], 1)), ".", ",") + " %" END' />
            </column>
            <column caption="% accès sûr" datatype='real' name="[m_safe]" role='measure' type='quantitative'>
              <calculation class='tableau' formula="SUM(IF NOT ISNULL([s_zone]) AND NOT ISNULL([w_zone]) THEN [s_zone] * [w_zone] END) / SUM(IF NOT ISNULL([s_zone]) AND NOT ISNULL([w_zone]) THEN [w_zone] END)" />
            </column>
            <column caption="Couverture accès sûr" datatype='real' name="[m_safe_cov]" role='measure' type='quantitative'>
              <calculation class='tableau' formula="SUM(IF NOT ISNULL([s_zone]) THEN [pop] END) / SUM([pop]) * 100" />
            </column>
            <column caption="Pays" datatype='string' name="[pays]" role='dimension' type='nominal' />
            <column caption="Population" datatype='real' name="[pop]" role='measure' type='quantitative' />
            <column caption="Population rurale" datatype='real' name="[pop_rur]" role='measure' type='quantitative' />
            <column caption="Population urbaine" datatype='real' name="[pop_urb]" role='measure' type='quantitative' />
            <column caption="Accès sûr (zone)" datatype='real' name="[s_zone]" role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [zone_code] WHEN "U" THEN [safe_U] WHEN "R" THEN [safe_R] ELSE [safe_T] END' />
            </column>
            <column caption="Accès sûr rural" datatype='real' name="[safe_R]" role='measure' type='quantitative' />
            <column caption="Accès sûr total" datatype='real' name="[safe_T]" role='measure' type='quantitative' />
            <column caption="Accès sûr urbain" datatype='real' name="[safe_U]" role='measure' type='quantitative' />
            <column caption="Population de la zone" datatype='real' name="[w_zone]" role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [zone_code] WHEN "U" THEN [pop_urb] WHEN "R" THEN [pop_rur] ELSE [pop] END' />
            </column>
            <column caption="Année" datatype='integer' name="[year]" role='dimension' type='ordinal' />
            <column caption="Code zone" datatype='string' name="[zone_code]" role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2] WHEN "Urbain" THEN "U" WHEN "Rural" THEN "R" ELSE "T" END' />
            </column>
            <column-instance column="[f_annee]" derivation='None' name="[none:f_annee:nk]" pivot='key' type='nominal' />
            <column-instance column="[f_pays]" derivation='None' name="[none:f_pays:nk]" pivot='key' type='nominal' />
            <column-instance column="[ks_safe]" derivation='User' name="[usr:ks_safe:nk]" pivot='key' type='nominal' />
            <column-instance column="[kv_safe]" derivation='User' name="[usr:kv_safe:nk]" pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column="[pays_annee].[none:f_annee:nk]">
            <groupfilter function='member' level="[none:f_annee:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column="[pays_annee].[none:f_pays:nk]">
            <groupfilter function='member' level="[none:f_pays:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[pays_annee].[none:f_annee:nk]</column>
            <column>[pays_annee].[none:f_pays:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
        </style>
        <panes>
          <pane>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Text' />
            <encodings>
              <text column="[pays_annee].[usr:kv_safe:nk]" />
              <tooltip column="[pays_annee].[usr:ks_safe:nk]" />
            </encodings>
            <customized-label>
              <formatted-text>
                <run fontcolor='#5f7488' fontsize='9' bold='true'>ACCÈS SÛR
</run>
                <run fontcolor='#0b2236' fontsize='20' bold='true'>&lt;[pays_annee].[usr:kv_safe:nk]&gt;
</run>
                <run fontcolor='#5f7488' fontsize='8'>&lt;[pays_annee].[usr:ks_safe:nk]&gt;</run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows></rows>
        <cols></cols>
      </table>
    </worksheet>
