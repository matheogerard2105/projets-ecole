            </column>
            <column caption="Pays choisi" datatype='boolean' name="[f_pays]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="[pays] = [Parameters].[Parameter 5]" />
            </column>
            <column caption="Code pays" datatype='string' name="[iso3]" role='dimension' type='nominal' semantic-role='[Country].[ISO3166_3]' />
            <column caption="KPI Population (détail)" datatype='string' name="[ks_pop]" role='measure' type='nominal'>
              <calculation class='tableau' formula='STR(COUNTD([iso3])) + " pays retenus"' />
            </column>
            <column caption="KPI Population" datatype='string' name="[kv_pop]" role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL(SUM([pop])) THEN "n.d." ELSEIF SUM([pop]) &gt;= 1e9 THEN REPLACE(STR(ROUND(SUM([pop])/1e9, 2)), ".", ",") + " Md" ELSEIF SUM([pop]) &gt;= 1e6 THEN REPLACE(STR(ROUND(SUM([pop])/1e6, 1)), ".", ",") + " M" ELSEIF SUM([pop]) &gt;= 1e3 THEN STR(INT(ROUND(SUM([pop])/1e3, 0))) + " k" ELSE STR(INT(ROUND(SUM([pop]), 0))) END' />
            </column>
            <column caption="Pays" datatype='string' name="[pays]" role='dimension' type='nominal' />
            <column caption="Population" datatype='real' name="[pop]" role='measure' type='quantitative' />
            <column caption="Année" datatype='integer' name="[year]" role='dimension' type='ordinal' />
            <column-instance column="[f_annee]" derivation='None' name="[none:f_annee:nk]" pivot='key' type='nominal' />
            <column-instance column="[f_pays]" derivation='None' name="[none:f_pays:nk]" pivot='key' type='nominal' />
            <column-instance column="[ks_pop]" derivation='User' name="[usr:ks_pop:nk]" pivot='key' type='nominal' />
            <column-instance column="[kv_pop]" derivation='User' name="[usr:kv_pop:nk]" pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column="[pays_annee].[none:f_annee:nk]">
            <groupfilter function='member' level="[none:f_annee:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column="[pays_annee].[none:f_pays:nk]">
            <groupfilter function='member' level="[none:f_pays:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[pays_annee].[none:f_annee:nk]</column>
            <column>[pays_annee].[none:f_pays:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
        </style>
        <panes>
          <pane>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Text' />
            <encodings>
              <text column="[pays_annee].[usr:kv_pop:nk]" />
              <tooltip column="[pays_annee].[usr:ks_pop:nk]" />
            </encodings>
            <customized-label>
              <formatted-text>
                <run fontcolor='#5f7488' fontsize='9' bold='true'>POPULATION
</run>
                <run fontcolor='#0b2236' fontsize='20' bold='true'>&lt;[pays_annee].[usr:kv_pop:nk]&gt;
</run>
                <run fontcolor='#5f7488' fontsize='8'>&lt;[pays_annee].[usr:ks_pop:nk]&gt;</run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows></rows>
        <cols></cols>
      </table>
    </worksheet>
    <worksheet name="Pays · KPI Accès basique">
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#0b2236' fontsize='11'>Accès basique</run>
          </formatted-text>
