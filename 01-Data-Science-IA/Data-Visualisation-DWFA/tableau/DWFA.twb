          </datasource-dependencies>
          <filter class='categorical' column="[pays_annee].[none:f_annee:nk]">
            <groupfilter function='member' level="[none:f_annee:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column="[pays_annee].[none:f_retenu:nk]">
            <groupfilter function='member' level="[none:f_retenu:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[pays_annee].[none:f_annee:nk]</column>
            <column>[pays_annee].[none:f_retenu:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
        </style>
        <panes>
          <pane>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Text' />
            <encodings>
              <text column="[pays_annee].[usr:kv_urb:nk]" />
              <tooltip column="[pays_annee].[usr:ks_urb:nk]" />
            </encodings>
            <customized-label>
              <formatted-text>
                <run fontcolor='#5f7488' fontsize='9' bold='true'>TAUX D'URBANISATION
</run>
                <run fontcolor='#0b2236' fontsize='20' bold='true'>&lt;[pays_annee].[usr:kv_urb:nk]&gt;
</run>
                <run fontcolor='#5f7488' fontsize='8'>&lt;[pays_annee].[usr:ks_urb:nk]&gt;</run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows></rows>
        <cols></cols>
      </table>
    </worksheet>
    <worksheet name="Monde · KPI Stabilité politique">
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#0b2236' fontsize='11'>Stabilité politique</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Pays × année" name="pays_annee" />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption="Année" datatype='integer' name="[Parameter 1]" param-domain-type='range' role='measure' type='quantitative' value="2017">
              <calculation class='tableau' formula="2017" />
              <range granularity='1' max='2017' min='2000' />
            </column>
            <column caption="Stabilité politique minimale" datatype='real' name="[Parameter 3]" param-domain-type='range' role='measure' type='quantitative' value="-3.5">
              <calculation class='tableau' formula="-3.5" />
              <range granularity='0.1' max='1.5' min='-3.5' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource="pays_annee">
            <column caption="Année choisie" datatype='boolean' name="[f_annee]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="[year] = [Parameters].[Parameter 1]" />
            </column>
            <column caption="Retenu (stabilité)" datatype='boolean' name="[f_retenu]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="ISNULL([stability]) OR [stability] &gt;= [Parameters].[Parameter 3]" />
            </column>
            <column caption="Code pays" datatype='string' name="[iso3]" role='dimension' type='nominal' semantic-role='[Country].[ISO3166_3]' />
            <column caption="KPI Stabilité politique (détail)" datatype='string' name="[ks_stab]" role='measure' type='nominal'>
              <calculation class='tableau' formula='IF COUNT([iso3]) &gt; 0 THEN "moyenne des pays, de -2,5 à +2,5" END' />
            </column>
            <column caption="KPI Stabilité politique" datatype='string' name="[kv_stab]" role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL(AVG([stability])) THEN "n.d." ELSE REPLACE(STR(ROUND(AVG([stability]), 2)), ".", ",") END' />
            </column>
            <column caption="Stabilité politique" datatype='real' name="[stability]" role='measure' type='quantitative' />
            <column caption="Année" datatype='integer' name="[year]" role='dimension' type='ordinal' />
            <column-instance column="[f_annee]" derivation='None' name="[none:f_annee:nk]" pivot='key' type='nominal' />
            <column-instance column="[f_retenu]" derivation='None' name="[none:f_retenu:nk]" pivot='key' type='nominal' />
            <column-instance column="[ks_stab]" derivation='User' name="[usr:ks_stab:nk]" pivot='key' type='nominal' />
            <column-instance column="[kv_stab]" derivation='User' name="[usr:kv_stab:nk]" pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column="[pays_annee].[none:f_annee:nk]">
            <groupfilter function='member' level="[none:f_annee:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column="[pays_annee].[none:f_retenu:nk]">
            <groupfilter function='member' level="[none:f_retenu:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[pays_annee].[none:f_annee:nk]</column>
            <column>[pays_annee].[none:f_retenu:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
        </style>
        <panes>
          <pane>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Text' />
            <encodings>
              <text column="[pays_annee].[usr:kv_stab:nk]" />
              <tooltip column="[pays_annee].[usr:ks_stab:nk]" />
            </encodings>
            <customized-label>
              <formatted-text>
                <run fontcolor='#5f7488' fontsize='9' bold='true'>STABILITÉ POLITIQUE
</run>
                <run fontcolor='#0b2236' fontsize='20' bold='true'>&lt;[pays_annee].[usr:kv_stab:nk]&gt;
</run>
                <run fontcolor='#5f7488' fontsize='8'>&lt;[pays_annee].[usr:ks_stab:nk]&gt;</run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows></rows>
        <cols></cols>
      </table>
    </worksheet>
    <worksheet name="Monde · Carte">
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#0b2236' fontsize='11'>Accès basique à l'eau potable (survoler pour le détail)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Pays × année" name="pays_annee" />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='Parameters'>
            <column caption="Année" datatype='integer' name="[Parameter 1]" param-domain-type='range' role='measure' type='quantitative' value="2017">
              <calculation class='tableau' formula="2017" />
              <range granularity='1' max='2017' min='2000' />
            </column>
            <column caption="Zone" datatype='string' name="[Parameter 2]" param-domain-type='list' role='measure' type='nominal' value='"Total"'>
              <calculation class='tableau' formula='"Total"' />
              <members>
                <member value='"Total"' />
                <member value='"Urbain"' />
                <member value='"Rural"' />
              </members>
            </column>
            <column caption="Stabilité politique minimale" datatype='real' name="[Parameter 3]" param-domain-type='range' role='measure' type='quantitative' value="-3.5">
              <calculation class='tableau' formula="-3.5" />
              <range granularity='0.1' max='1.5' min='-3.5' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource="pays_annee">
            <column datatype='real' name="[Latitude (generated)]" role='measure' type='quantitative' />
            <column datatype='real' name="[Longitude (generated)]" role='measure' type='quantitative' />
            <column caption="Accès basique (zone)" datatype='real' name="[b_zone]" role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [zone_code] WHEN "U" THEN [basic_U] WHEN "R" THEN [basic_R] ELSE [basic_T] END' />
            </column>
            <column caption="Accès basique rural" datatype='real' name="[basic_R]" role='measure' type='quantitative' />
            <column caption="Accès basique total" datatype='real' name="[basic_T]" role='measure' type='quantitative' />
            <column caption="Accès basique urbain" datatype='real' name="[basic_U]" role='measure' type='quantitative' />
            <column caption="Classe d'accès basique" datatype='string' name="[classe]" role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF NOT [f_retenu] THEN "exclu (stabilité)" ELSEIF ISNULL([b_zone]) THEN "n.d." ELSEIF [b_zone] &lt; 50 THEN "&lt; 50 %" ELSEIF [b_zone] &lt; 70 THEN "50-70 %" ELSEIF [b_zone] &lt; 85 THEN "70-85 %" ELSEIF [b_zone] &lt; 95 THEN "85-95 %" ELSEIF [b_zone] &lt; 99 THEN "95-99 %" ELSE "≥ 99 %" END' />
            </column>
            <column caption="Année choisie" datatype='boolean' name="[f_annee]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="[year] = [Parameters].[Parameter 1]" />
            </column>
            <column caption="Retenu (stabilité)" datatype='boolean' name="[f_retenu]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="ISNULL([stability]) OR [stability] &gt;= [Parameters].[Parameter 3]" />
            </column>
            <column caption="Code pays" datatype='string' name="[iso3]" role='dimension' type='nominal' semantic-role='[Country].[ISO3166_3]' />
            <column caption="Pays" datatype='string' name="[pays]" role='dimension' type='nominal' />
            <column caption="Population" datatype='real' name="[pop]" role='measure' type='quantitative' />
            <column caption="Accès sûr (zone)" datatype='real' name="[s_zone]" role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [zone_code] WHEN "U" THEN [safe_U] WHEN "R" THEN [safe_R] ELSE [safe_T] END' />
            </column>
            <column caption="Accès sûr rural" datatype='real' name="[safe_R]" role='measure' type='quantitative' />
            <column caption="Accès sûr total" datatype='real' name="[safe_T]" role='measure' type='quantitative' />
            <column caption="Accès sûr urbain" datatype='real' name="[safe_U]" role='measure' type='quantitative' />
            <column caption="Stabilité politique" datatype='real' name="[stability]" role='measure' type='quantitative' />
            <column caption="Année" datatype='integer' name="[year]" role='dimension' type='ordinal' />
            <column caption="Code zone" datatype='string' name="[zone_code]" role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2] WHEN "Urbain" THEN "U" WHEN "Rural" THEN "R" ELSE "T" END' />
            </column>
            <column-instance column="[b_zone]" derivation='Avg' name="[avg:b_zone:qk]" pivot='key' type='quantitative' />
            <column-instance column="[s_zone]" derivation='Avg' name="[avg:s_zone:qk]" pivot='key' type='quantitative' />
            <column-instance column="[stability]" derivation='Avg' name="[avg:stability:qk]" pivot='key' type='quantitative' />
            <column-instance column="[classe]" derivation='None' name="[none:classe:nk]" pivot='key' type='nominal' />
            <column-instance column="[f_annee]" derivation='None' name="[none:f_annee:nk]" pivot='key' type='nominal' />
            <column-instance column="[iso3]" derivation='None' name="[none:iso3:nk]" pivot='key' type='nominal' />
            <column-instance column="[pays]" derivation='None' name="[none:pays:nk]" pivot='key' type='nominal' />
            <column-instance column="[pop]" derivation='Sum' name="[sum:pop:qk]" pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column="[pays_annee].[none:f_annee:nk]">
            <groupfilter function='member' level="[none:f_annee:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[pays_annee].[none:f_annee:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
        </style>
        <panes>
          <pane>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Multipolygon' />
            <encodings>
              <color column="[pays_annee].[none:classe:nk]" />
              <lod column="[pays_annee].[none:iso3:nk]" />
              <lod column="[pays_annee].[none:pays:nk]" />
              <tooltip column="[pays_annee].[avg:b_zone:qk]" />
              <tooltip column="[pays_annee].[avg:s_zone:qk]" />
              <tooltip column="[pays_annee].[avg:stability:qk]" />
              <tooltip column="[pays_annee].[sum:pop:qk]" />
            </encodings>
            <style>
              <style-rule element='mark'>
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[pays_annee].[Latitude (generated)]</rows>
        <cols>[pays_annee].[Longitude (generated)]</cols>
      </table>
    </worksheet>
    <worksheet name="Monde · Sans accès par continent">
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#0b2236' fontsize='11'>Personnes sans accès basique, par continent (millions)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Pays × année" name="pays_annee" />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption="Année" datatype='integer' name="[Parameter 1]" param-domain-type='range' role='measure' type='quantitative' value="2017">
              <calculation class='tableau' formula="2017" />
              <range granularity='1' max='2017' min='2000' />
            </column>
            <column caption="Stabilité politique minimale" datatype='real' name="[Parameter 3]" param-domain-type='range' role='measure' type='quantitative' value="-3.5">
              <calculation class='tableau' formula="-3.5" />
              <range granularity='0.1' max='1.5' min='-3.5' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource="pays_annee">
            <column caption="Continent" datatype='string' name="[continent]" role='dimension' type='nominal' />
            <column caption="Année choisie" datatype='boolean' name="[f_annee]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="[year] = [Parameters].[Parameter 1]" />
            </column>
            <column caption="Retenu (stabilité)" datatype='boolean' name="[f_retenu]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="ISNULL([stability]) OR [stability] &gt;= [Parameters].[Parameter 3]" />
            </column>
            <column caption="Personnes sans accès basique (millions)" datatype='real' name="[m_sans_M]" role='measure' type='quantitative'>
              <calculation class='tableau' formula="SUM([pop_without_basic]) / 1e6" />
            </column>
            <column caption="Personnes sans accès basique" datatype='real' name="[pop_without_basic]" role='measure' type='quantitative' />
            <column caption="Stabilité politique" datatype='real' name="[stability]" role='measure' type='quantitative' />
            <column caption="Année" datatype='integer' name="[year]" role='dimension' type='ordinal' />
            <column-instance column="[continent]" derivation='None' name="[none:continent:nk]" pivot='key' type='nominal' />
            <column-instance column="[f_annee]" derivation='None' name="[none:f_annee:nk]" pivot='key' type='nominal' />
            <column-instance column="[f_retenu]" derivation='None' name="[none:f_retenu:nk]" pivot='key' type='nominal' />
            <column-instance column="[m_sans_M]" derivation='User' name="[usr:m_sans_M:qk]" pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column="[pays_annee].[none:f_annee:nk]">
            <groupfilter function='member' level="[none:f_annee:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column="[pays_annee].[none:f_retenu:nk]">
            <groupfilter function='member' level="[none:f_retenu:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <sort class='computed' column="[pays_annee].[none:continent:nk]" direction='DESC' using="[pays_annee].[usr:m_sans_M:qk]" />
          <slices>
            <column>[pays_annee].[none:f_annee:nk]</column>
            <column>[pays_annee].[none:f_retenu:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='title' class='0' field="[pays_annee].[usr:m_sans_M:qk]" scope='cols' value="millions de personnes" />
          </style-rule>
          <style-rule element='cell'>
            <format attr='text-format' field="[pays_annee].[usr:m_sans_M:qk]" value="#,##0" />
          </style-rule>
        </style>
        <panes>
          <pane>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <text column="[pays_annee].[usr:m_sans_M:qk]" />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='mark-color' value='#1c5cab' />
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[pays_annee].[none:continent:nk]</rows>
        <cols>[pays_annee].[usr:m_sans_M:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Monde · Évolution">
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#0b2236' fontsize='11'>Évolution de l'accès à l'eau, 2000-2017 (moyennes pondérées par la population)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Indicateurs (format long)" name="indicateurs" />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption="Stabilité politique minimale" datatype='real' name="[Parameter 3]" param-domain-type='range' role='measure' type='quantitative' value="-3.5">
              <calculation class='tableau' formula="-3.5" />
              <range granularity='0.1' max='1.5' min='-3.5' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource="indicateurs">
            <column caption="Séries de la courbe" datatype='boolean' name="[f_courbe]" role='dimension' type='nominal'>
              <calculation class='tableau' formula='[niveau] = "Monde" AND (([indicateur] = "Accès basique") OR ([indicateur] = "Accès sûr" AND [zone] = "T"))' />
            </column>
            <column caption="Panel accès sûr (si série sûre)" datatype='boolean' name="[f_panel]" role='dimension' type='nominal'>
              <calculation class='tableau' formula='[indicateur] &lt;&gt; "Accès sûr" OR [panel_sur]' />
            </column>
            <column caption="Retenu (stabilité)" datatype='boolean' name="[f_retenu]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="ISNULL([stability]) OR [stability] &gt;= [Parameters].[Parameter 3]" />
            </column>
            <column caption="Indicateur" datatype='string' name="[indicateur]" role='dimension' type='nominal' />
            <column caption="Série" datatype='string' name="[libelle]" role='dimension' type='nominal' />
            <column caption="Valeur pondérée" datatype='real' name="[m_val]" role='measure' type='quantitative'>
              <calculation class='tableau' formula="SUM(IF NOT ISNULL([valeur]) AND NOT ISNULL([poids]) THEN [valeur] * [poids] END) / SUM(IF NOT ISNULL([valeur]) AND NOT ISNULL([poids]) THEN [poids] END)" />
            </column>
            <column caption="Niveau" datatype='string' name="[niveau]" role='dimension' type='nominal' />
            <column caption="Panel accès sûr" datatype='boolean' name="[panel_sur]" role='dimension' type='nominal' />
            <column caption="Poids" datatype='real' name="[poids]" role='measure' type='quantitative' />
            <column caption="Stabilité politique" datatype='real' name="[stability]" role='measure' type='quantitative' />
            <column caption="Valeur" datatype='real' name="[valeur]" role='measure' type='quantitative' />
            <column caption="Année" datatype='integer' name="[year]" role='dimension' type='ordinal' />
            <column caption="Zone" datatype='string' name="[zone]" role='dimension' type='nominal' />
            <column-instance column="[f_courbe]" derivation='None' name="[none:f_courbe:nk]" pivot='key' type='nominal' />
            <column-instance column="[f_panel]" derivation='None' name="[none:f_panel:nk]" pivot='key' type='nominal' />
            <column-instance column="[f_retenu]" derivation='None' name="[none:f_retenu:nk]" pivot='key' type='nominal' />
            <column-instance column="[libelle]" derivation='None' name="[none:libelle:nk]" pivot='key' type='nominal' />
            <column-instance column="[year]" derivation='None' name="[none:year:ok]" pivot='key' type='ordinal' />
            <column-instance column="[m_val]" derivation='User' name="[usr:m_val:qk]" pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column="[indicateurs].[none:f_courbe:nk]">
            <groupfilter function='member' level="[none:f_courbe:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column="[indicateurs].[none:f_panel:nk]">
            <groupfilter function='member' level="[none:f_panel:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column="[indicateurs].[none:f_retenu:nk]">
            <groupfilter function='member' level="[none:f_retenu:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[indicateurs].[none:f_courbe:nk]</column>
            <column>[indicateurs].[none:f_panel:nk]</column>
            <column>[indicateurs].[none:f_retenu:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='title' class='0' field="[indicateurs].[usr:m_val:qk]" scope='rows' value="% de la population" />
          </style-rule>
        </style>
        <panes>
          <pane>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Line' />
            <encodings>
              <color column="[indicateurs].[none:libelle:nk]" />
            </encodings>
            <style>
              <style-rule element='mark'>
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[indicateurs].[usr:m_val:qk]</rows>
        <cols>[indicateurs].[none:year:ok]</cols>
      </table>
    </worksheet>
    <worksheet name="Monde · Échelle de service">
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#0b2236' fontsize='11'>Échelle de service par continent (% de la population, pays avec données « sûr »)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Indicateurs (format long)" name="indicateurs" />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption="Année" datatype='integer' name="[Parameter 1]" param-domain-type='range' role='measure' type='quantitative' value="2017">
              <calculation class='tableau' formula="2017" />
              <range granularity='1' max='2017' min='2000' />
            </column>
            <column caption="Stabilité politique minimale" datatype='real' name="[Parameter 3]" param-domain-type='range' role='measure' type='quantitative' value="-3.5">
              <calculation class='tableau' formula="-3.5" />
              <range granularity='0.1' max='1.5' min='-3.5' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource="indicateurs">
            <column caption="Continent" datatype='string' name="[continent]" role='dimension' type='nominal' />
            <column caption="Année choisie" datatype='boolean' name="[f_annee]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="[year] = [Parameters].[Parameter 1]" />
            </column>
            <column caption="Échelle (total, sûr renseigné)" datatype='boolean' name="[f_ech_monde]" role='dimension' type='nominal'>
              <calculation class='tableau' formula='[indicateur] = "Échelle" AND [zone] = "T" AND [sur_renseigne]' />
            </column>
            <column caption="Retenu (stabilité)" datatype='boolean' name="[f_retenu]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="ISNULL([stability]) OR [stability] &gt;= [Parameters].[Parameter 3]" />
            </column>
            <column caption="Indicateur" datatype='string' name="[indicateur]" role='dimension' type='nominal' />
            <column caption="Série" datatype='string' name="[libelle]" role='dimension' type='nominal' />
            <column caption="Valeur pondérée" datatype='real' name="[m_val]" role='measure' type='quantitative'>
              <calculation class='tableau' formula="SUM(IF NOT ISNULL([valeur]) AND NOT ISNULL([poids]) THEN [valeur] * [poids] END) / SUM(IF NOT ISNULL([valeur]) AND NOT ISNULL([poids]) THEN [poids] END)" />
            </column>
            <column caption="Poids" datatype='real' name="[poids]" role='measure' type='quantitative' />
            <column caption="Stabilité politique" datatype='real' name="[stability]" role='measure' type='quantitative' />
            <column caption="Accès sûr renseigné" datatype='boolean' name="[sur_renseigne]" role='dimension' type='nominal' />
            <column caption="Valeur" datatype='real' name="[valeur]" role='measure' type='quantitative' />
            <column caption="Année" datatype='integer' name="[year]" role='dimension' type='ordinal' />
            <column caption="Zone" datatype='string' name="[zone]" role='dimension' type='nominal' />
            <column-instance column="[continent]" derivation='None' name="[none:continent:nk]" pivot='key' type='nominal' />
            <column-instance column="[f_annee]" derivation='None' name="[none:f_annee:nk]" pivot='key' type='nominal' />
            <column-instance column="[f_ech_monde]" derivation='None' name="[none:f_ech_monde:nk]" pivot='key' type='nominal' />
            <column-instance column="[f_retenu]" derivation='None' name="[none:f_retenu:nk]" pivot='key' type='nominal' />
            <column-instance column="[libelle]" derivation='None' name="[none:libelle:nk]" pivot='key' type='nominal' />
            <column-instance column="[m_val]" derivation='User' name="[usr:m_val:qk]" pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column="[indicateurs].[none:f_ech_monde:nk]">
            <groupfilter function='member' level="[none:f_ech_monde:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column="[indicateurs].[none:f_annee:nk]">
            <groupfilter function='member' level="[none:f_annee:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column="[indicateurs].[none:f_retenu:nk]">
            <groupfilter function='member' level="[none:f_retenu:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[indicateurs].[none:f_ech_monde:nk]</column>
            <column>[indicateurs].[none:f_annee:nk]</column>
            <column>[indicateurs].[none:f_retenu:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='title' class='0' field="[indicateurs].[usr:m_val:qk]" scope='rows' value="% de la population" />
          </style-rule>
          <style-rule element='cell'>
            <format attr='text-format' field="[indicateurs].[usr:m_val:qk]" value="#,##0" />
          </style-rule>
        </style>
        <panes>
          <pane>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column="[indicateurs].[none:libelle:nk]" />
              <text column="[indicateurs].[usr:m_val:qk]" />
            </encodings>
            <style>
              <style-rule element='mark'>
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[indicateurs].[usr:m_val:qk]</rows>
        <cols>[indicateurs].[none:continent:nk]</cols>
      </table>
    </worksheet>
    <worksheet name="Monde · Ville campagne">
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#0b2236' fontsize='11'>Écart ville / campagne par continent (accès basique, %)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Indicateurs (format long)" name="indicateurs" />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption="Année" datatype='integer' name="[Parameter 1]" param-domain-type='range' role='measure' type='quantitative' value="2017">
              <calculation class='tableau' formula="2017" />
              <range granularity='1' max='2017' min='2000' />
            </column>
            <column caption="Stabilité politique minimale" datatype='real' name="[Parameter 3]" param-domain-type='range' role='measure' type='quantitative' value="-3.5">
              <calculation class='tableau' formula="-3.5" />
              <range granularity='0.1' max='1.5' min='-3.5' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource="indicateurs">
            <column caption="Continent" datatype='string' name="[continent]" role='dimension' type='nominal' />
            <column caption="Année choisie" datatype='boolean' name="[f_annee]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="[year] = [Parameters].[Parameter 1]" />
            </column>
            <column caption="Retenu (stabilité)" datatype='boolean' name="[f_retenu]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="ISNULL([stability]) OR [stability] &gt;= [Parameters].[Parameter 3]" />
            </column>
            <column caption="Accès basique urbain / rural" datatype='boolean' name="[f_vc]" role='dimension' type='nominal'>
              <calculation class='tableau' formula='[niveau] = "Monde" AND [indicateur] = "Accès basique" AND [zone] &lt;&gt; "T"' />
            </column>
            <column caption="Indicateur" datatype='string' name="[indicateur]" role='dimension' type='nominal' />
            <column caption="Milieu" datatype='string' name="[lib_vc]" role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [zone] = "U" THEN "Urbain" ELSE "Rural" END' />
            </column>
            <column caption="Valeur pondérée" datatype='real' name="[m_val]" role='measure' type='quantitative'>
              <calculation class='tableau' formula="SUM(IF NOT ISNULL([valeur]) AND NOT ISNULL([poids]) THEN [valeur] * [poids] END) / SUM(IF NOT ISNULL([valeur]) AND NOT ISNULL([poids]) THEN [poids] END)" />
            </column>
            <column caption="Niveau" datatype='string' name="[niveau]" role='dimension' type='nominal' />
            <column caption="Poids" datatype='real' name="[poids]" role='measure' type='quantitative' />
            <column caption="Stabilité politique" datatype='real' name="[stability]" role='measure' type='quantitative' />
            <column caption="Valeur" datatype='real' name="[valeur]" role='measure' type='quantitative' />
            <column caption="Année" datatype='integer' name="[year]" role='dimension' type='ordinal' />
            <column caption="Zone" datatype='string' name="[zone]" role='dimension' type='nominal' />
            <column-instance column="[continent]" derivation='None' name="[none:continent:nk]" pivot='key' type='nominal' />
            <column-instance column="[f_annee]" derivation='None' name="[none:f_annee:nk]" pivot='key' type='nominal' />
            <column-instance column="[f_retenu]" derivation='None' name="[none:f_retenu:nk]" pivot='key' type='nominal' />
            <column-instance column="[f_vc]" derivation='None' name="[none:f_vc:nk]" pivot='key' type='nominal' />
            <column-instance column="[lib_vc]" derivation='None' name="[none:lib_vc:nk]" pivot='key' type='nominal' />
            <column-instance column="[m_val]" derivation='User' name="[usr:m_val:qk]" pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column="[indicateurs].[none:f_vc:nk]">
            <groupfilter function='member' level="[none:f_vc:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column="[indicateurs].[none:f_annee:nk]">
            <groupfilter function='member' level="[none:f_annee:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column="[indicateurs].[none:f_retenu:nk]">
            <groupfilter function='member' level="[none:f_retenu:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[indicateurs].[none:f_vc:nk]</column>
            <column>[indicateurs].[none:f_annee:nk]</column>
            <column>[indicateurs].[none:f_retenu:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='title' class='0' field="[indicateurs].[usr:m_val:qk]" scope='rows' value="Accès basique (%)" />
          </style-rule>
          <style-rule element='cell'>
            <format attr='text-format' field="[indicateurs].[usr:m_val:qk]" value="#,##0" />
          </style-rule>
        </style>
        <panes>
          <pane>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column="[indicateurs].[none:lib_vc:nk]" />
              <text column="[indicateurs].[usr:m_val:qk]" />
            </encodings>
            <style>
              <style-rule element='mark'>
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[indicateurs].[usr:m_val:qk]</rows>
        <cols>([indicateurs].[none:continent:nk] / [indicateurs].[none:lib_vc:nk])</cols>
      </table>
    </worksheet>
    <worksheet name="Monde · Domaine 1 création">
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#0b2236' fontsize='11'>DOMAINE 1 · CRÉATION — Accès basique et urbanisation (taille : personnes sans accès)</run>
