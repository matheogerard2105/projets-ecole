        </view>
        <style>
          <style-rule element='axis'>
            <format attr='title' class='0' field="[pays_annee].[avg:efficiency_score:qk]" scope='rows' value="Score d'efficacité (0-100)" />
            <format attr='title' class='0' field="[pays_annee].[avg:stability_2016:qk]" scope='cols' value="Stabilité politique 2016" />
          </style-rule>
        </style>
        <panes>
          <pane>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Circle' />
            <encodings>
              <lod column="[pays_annee].[none:iso3:nk]" />
              <lod column="[pays_annee].[none:pays:nk]" />
              <tooltip column="[pays_annee].[avg:mortality_2016:qk]" />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='mark-color' value='#2a78d6' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[pays_annee].[avg:efficiency_score:qk]</rows>
        <cols>[pays_annee].[avg:stability_2016:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Continent · KPI Population">
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#0b2236' fontsize='11'>Population</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Pays × année" name="pays_annee" />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption="Année" datatype='integer' name="[Parameter 1]" param-domain-type='range' role='measure' type='quantitative' value="2017">
              <calculation class='tableau' formula="2017" />
              <range granularity='1' max='2017' min='2000' />
            </column>
            <column caption="Stabilité politique minimale" datatype='real' name="[Parameter 3]" param-domain-type='range' role='measure' type='quantitative' value="-3.5">
              <calculation class='tableau' formula="-3.5" />
              <range granularity='0.1' max='1.5' min='-3.5' />
            </column>
            <column caption="Continent (région OMS)" datatype='string' name="[Parameter 4]" param-domain-type='list' role='measure' type='nominal' value='"Afrique"'>
              <calculation class='tableau' formula='"Afrique"' />
              <members>
                <member value='"Afrique"' />
                <member value='"Amériques"' />
                <member value='"Asie du Sud-Est"' />
                <member value='"Europe"' />
                <member value='"Méditerranée orientale"' />
                <member value='"Pacifique occidental"' />
              </members>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource="pays_annee">
            <column caption="Continent" datatype='string' name="[continent]" role='dimension' type='nominal' />
            <column caption="Année choisie" datatype='boolean' name="[f_annee]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="[year] = [Parameters].[Parameter 1]" />
            </column>
            <column caption="Dans le continent choisi" datatype='boolean' name="[f_continent]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="[continent] = [Parameters].[Parameter 4]" />
            </column>
            <column caption="Retenu (stabilité)" datatype='boolean' name="[f_retenu]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="ISNULL([stability]) OR [stability] &gt;= [Parameters].[Parameter 3]" />
            </column>
            <column caption="Code pays" datatype='string' name="[iso3]" role='dimension' type='nominal' semantic-role='[Country].[ISO3166_3]' />
            <column caption="KPI Population (détail)" datatype='string' name="[ks_pop]" role='measure' type='nominal'>
              <calculation class='tableau' formula='STR(COUNTD([iso3])) + " pays retenus"' />
            </column>
            <column caption="KPI Population" datatype='string' name="[kv_pop]" role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL(SUM([pop])) THEN "n.d." ELSEIF SUM([pop]) &gt;= 1e9 THEN REPLACE(STR(ROUND(SUM([pop])/1e9, 2)), ".", ",") + " Md" ELSEIF SUM([pop]) &gt;= 1e6 THEN REPLACE(STR(ROUND(SUM([pop])/1e6, 1)), ".", ",") + " M" ELSEIF SUM([pop]) &gt;= 1e3 THEN STR(INT(ROUND(SUM([pop])/1e3, 0))) + " k" ELSE STR(INT(ROUND(SUM([pop]), 0))) END' />
            </column>
            <column caption="Population" datatype='real' name="[pop]" role='measure' type='quantitative' />
            <column caption="Stabilité politique" datatype='real' name="[stability]" role='measure' type='quantitative' />
            <column caption="Année" datatype='integer' name="[year]" role='dimension' type='ordinal' />
            <column-instance column="[f_annee]" derivation='None' name="[none:f_annee:nk]" pivot='key' type='nominal' />
            <column-instance column="[f_continent]" derivation='None' name="[none:f_continent:nk]" pivot='key' type='nominal' />
            <column-instance column="[f_retenu]" derivation='None' name="[none:f_retenu:nk]" pivot='key' type='nominal' />
            <column-instance column="[ks_pop]" derivation='User' name="[usr:ks_pop:nk]" pivot='key' type='nominal' />
            <column-instance column="[kv_pop]" derivation='User' name="[usr:kv_pop:nk]" pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column="[pays_annee].[none:f_annee:nk]">
            <groupfilter function='member' level="[none:f_annee:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column="[pays_annee].[none:f_retenu:nk]">
            <groupfilter function='member' level="[none:f_retenu:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column="[pays_annee].[none:f_continent:nk]">
            <groupfilter function='member' level="[none:f_continent:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[pays_annee].[none:f_annee:nk]</column>
            <column>[pays_annee].[none:f_retenu:nk]</column>
            <column>[pays_annee].[none:f_continent:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
        </style>
        <panes>
          <pane>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Text' />
            <encodings>
              <text column="[pays_annee].[usr:kv_pop:nk]" />
              <tooltip column="[pays_annee].[usr:ks_pop:nk]" />
            </encodings>
            <customized-label>
              <formatted-text>
                <run fontcolor='#5f7488' fontsize='9' bold='true'>POPULATION
</run>
                <run fontcolor='#0b2236' fontsize='20' bold='true'>&lt;[pays_annee].[usr:kv_pop:nk]&gt;
</run>
                <run fontcolor='#5f7488' fontsize='8'>&lt;[pays_annee].[usr:ks_pop:nk]&gt;</run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows></rows>
        <cols></cols>
      </table>
    </worksheet>
    <worksheet name="Continent · KPI Accès basique">
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#0b2236' fontsize='11'>Accès basique</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Pays × année" name="pays_annee" />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption="Année" datatype='integer' name="[Parameter 1]" param-domain-type='range' role='measure' type='quantitative' value="2017">
              <calculation class='tableau' formula="2017" />
              <range granularity='1' max='2017' min='2000' />
            </column>
            <column caption="Zone" datatype='string' name="[Parameter 2]" param-domain-type='list' role='measure' type='nominal' value='"Total"'>
              <calculation class='tableau' formula='"Total"' />
              <members>
                <member value='"Total"' />
                <member value='"Urbain"' />
                <member value='"Rural"' />
              </members>
            </column>
            <column caption="Stabilité politique minimale" datatype='real' name="[Parameter 3]" param-domain-type='range' role='measure' type='quantitative' value="-3.5">
              <calculation class='tableau' formula="-3.5" />
              <range granularity='0.1' max='1.5' min='-3.5' />
            </column>
            <column caption="Continent (région OMS)" datatype='string' name="[Parameter 4]" param-domain-type='list' role='measure' type='nominal' value='"Afrique"'>
              <calculation class='tableau' formula='"Afrique"' />
              <members>
                <member value='"Afrique"' />
                <member value='"Amériques"' />
                <member value='"Asie du Sud-Est"' />
                <member value='"Europe"' />
                <member value='"Méditerranée orientale"' />
                <member value='"Pacifique occidental"' />
              </members>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource="pays_annee">
            <column caption="Accès basique (zone)" datatype='real' name="[b_zone]" role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [zone_code] WHEN "U" THEN [basic_U] WHEN "R" THEN [basic_R] ELSE [basic_T] END' />
            </column>
            <column caption="Accès basique rural" datatype='real' name="[basic_R]" role='measure' type='quantitative' />
            <column caption="Accès basique total" datatype='real' name="[basic_T]" role='measure' type='quantitative' />
            <column caption="Accès basique urbain" datatype='real' name="[basic_U]" role='measure' type='quantitative' />
            <column caption="Continent" datatype='string' name="[continent]" role='dimension' type='nominal' />
            <column caption="Année choisie" datatype='boolean' name="[f_annee]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="[year] = [Parameters].[Parameter 1]" />
            </column>
            <column caption="Dans le continent choisi" datatype='boolean' name="[f_continent]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="[continent] = [Parameters].[Parameter 4]" />
            </column>
            <column caption="Retenu (stabilité)" datatype='boolean' name="[f_retenu]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="ISNULL([stability]) OR [stability] &gt;= [Parameters].[Parameter 3]" />
            </column>
            <column caption="Code pays" datatype='string' name="[iso3]" role='dimension' type='nominal' semantic-role='[Country].[ISO3166_3]' />
            <column caption="KPI Accès basique (détail)" datatype='string' name="[ks_basic]" role='measure' type='nominal'>
              <calculation class='tableau' formula="IF COUNT([iso3]) &gt; 0 THEN &quot;au moins un point d'eau amélioré&quot; END" />
            </column>
            <column caption="KPI Accès basique" datatype='string' name="[kv_basic]" role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([m_basic]) THEN "n.d." ELSE REPLACE(STR(ROUND([m_basic], 1)), ".", ",") + " %" END' />
            </column>
            <column caption="% accès basique" datatype='real' name="[m_basic]" role='measure' type='quantitative'>
              <calculation class='tableau' formula="SUM(IF NOT ISNULL([b_zone]) AND NOT ISNULL([w_zone]) THEN [b_zone] * [w_zone] END) / SUM(IF NOT ISNULL([b_zone]) AND NOT ISNULL([w_zone]) THEN [w_zone] END)" />
            </column>
            <column caption="Population" datatype='real' name="[pop]" role='measure' type='quantitative' />
            <column caption="Population rurale" datatype='real' name="[pop_rur]" role='measure' type='quantitative' />
            <column caption="Population urbaine" datatype='real' name="[pop_urb]" role='measure' type='quantitative' />
            <column caption="Stabilité politique" datatype='real' name="[stability]" role='measure' type='quantitative' />
            <column caption="Population de la zone" datatype='real' name="[w_zone]" role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [zone_code] WHEN "U" THEN [pop_urb] WHEN "R" THEN [pop_rur] ELSE [pop] END' />
            </column>
            <column caption="Année" datatype='integer' name="[year]" role='dimension' type='ordinal' />
            <column caption="Code zone" datatype='string' name="[zone_code]" role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2] WHEN "Urbain" THEN "U" WHEN "Rural" THEN "R" ELSE "T" END' />
            </column>
            <column-instance column="[f_annee]" derivation='None' name="[none:f_annee:nk]" pivot='key' type='nominal' />
            <column-instance column="[f_continent]" derivation='None' name="[none:f_continent:nk]" pivot='key' type='nominal' />
            <column-instance column="[f_retenu]" derivation='None' name="[none:f_retenu:nk]" pivot='key' type='nominal' />
            <column-instance column="[ks_basic]" derivation='User' name="[usr:ks_basic:nk]" pivot='key' type='nominal' />
            <column-instance column="[kv_basic]" derivation='User' name="[usr:kv_basic:nk]" pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column="[pays_annee].[none:f_annee:nk]">
            <groupfilter function='member' level="[none:f_annee:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column="[pays_annee].[none:f_retenu:nk]">
            <groupfilter function='member' level="[none:f_retenu:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column="[pays_annee].[none:f_continent:nk]">
            <groupfilter function='member' level="[none:f_continent:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[pays_annee].[none:f_annee:nk]</column>
            <column>[pays_annee].[none:f_retenu:nk]</column>
            <column>[pays_annee].[none:f_continent:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
        </style>
        <panes>
          <pane>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Text' />
            <encodings>
              <text column="[pays_annee].[usr:kv_basic:nk]" />
              <tooltip column="[pays_annee].[usr:ks_basic:nk]" />
            </encodings>
            <customized-label>
              <formatted-text>
                <run fontcolor='#5f7488' fontsize='9' bold='true'>ACCÈS BASIQUE
</run>
                <run fontcolor='#0b2236' fontsize='20' bold='true'>&lt;[pays_annee].[usr:kv_basic:nk]&gt;
</run>
                <run fontcolor='#5f7488' fontsize='8'>&lt;[pays_annee].[usr:ks_basic:nk]&gt;</run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows></rows>
        <cols></cols>
      </table>
    </worksheet>
    <worksheet name="Continent · KPI Accès sûr">
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#0b2236' fontsize='11'>Accès sûr</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Pays × année" name="pays_annee" />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption="Année" datatype='integer' name="[Parameter 1]" param-domain-type='range' role='measure' type='quantitative' value="2017">
              <calculation class='tableau' formula="2017" />
              <range granularity='1' max='2017' min='2000' />
            </column>
            <column caption="Zone" datatype='string' name="[Parameter 2]" param-domain-type='list' role='measure' type='nominal' value='"Total"'>
              <calculation class='tableau' formula='"Total"' />
              <members>
                <member value='"Total"' />
                <member value='"Urbain"' />
                <member value='"Rural"' />
              </members>
            </column>
            <column caption="Stabilité politique minimale" datatype='real' name="[Parameter 3]" param-domain-type='range' role='measure' type='quantitative' value="-3.5">
              <calculation class='tableau' formula="-3.5" />
              <range granularity='0.1' max='1.5' min='-3.5' />
            </column>
            <column caption="Continent (région OMS)" datatype='string' name="[Parameter 4]" param-domain-type='list' role='measure' type='nominal' value='"Afrique"'>
              <calculation class='tableau' formula='"Afrique"' />
              <members>
                <member value='"Afrique"' />
                <member value='"Amériques"' />
                <member value='"Asie du Sud-Est"' />
                <member value='"Europe"' />
                <member value='"Méditerranée orientale"' />
                <member value='"Pacifique occidental"' />
              </members>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource="pays_annee">
            <column caption="Continent" datatype='string' name="[continent]" role='dimension' type='nominal' />
            <column caption="Année choisie" datatype='boolean' name="[f_annee]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="[year] = [Parameters].[Parameter 1]" />
            </column>
            <column caption="Dans le continent choisi" datatype='boolean' name="[f_continent]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="[continent] = [Parameters].[Parameter 4]" />
            </column>
            <column caption="Retenu (stabilité)" datatype='boolean' name="[f_retenu]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="ISNULL([stability]) OR [stability] &gt;= [Parameters].[Parameter 3]" />
            </column>
            <column caption="KPI Accès sûr (détail)" datatype='string' name="[ks_safe]" role='measure' type='nominal'>
              <calculation class='tableau' formula='"données pour " + STR(INT(ROUND([m_safe_cov], 0))) + " % de la population"' />
            </column>
            <column caption="KPI Accès sûr" datatype='string' name="[kv_safe]" role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([m_safe]) THEN "n.d." ELSE REPLACE(STR(ROUND([m_safe], 1)), ".", ",") + " %" END' />
            </column>
            <column caption="% accès sûr" datatype='real' name="[m_safe]" role='measure' type='quantitative'>
              <calculation class='tableau' formula="SUM(IF NOT ISNULL([s_zone]) AND NOT ISNULL([w_zone]) THEN [s_zone] * [w_zone] END) / SUM(IF NOT ISNULL([s_zone]) AND NOT ISNULL([w_zone]) THEN [w_zone] END)" />
            </column>
            <column caption="Couverture accès sûr" datatype='real' name="[m_safe_cov]" role='measure' type='quantitative'>
              <calculation class='tableau' formula="SUM(IF NOT ISNULL([s_zone]) THEN [pop] END) / SUM([pop]) * 100" />
            </column>
            <column caption="Population" datatype='real' name="[pop]" role='measure' type='quantitative' />
            <column caption="Population rurale" datatype='real' name="[pop_rur]" role='measure' type='quantitative' />
            <column caption="Population urbaine" datatype='real' name="[pop_urb]" role='measure' type='quantitative' />
            <column caption="Accès sûr (zone)" datatype='real' name="[s_zone]" role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [zone_code] WHEN "U" THEN [safe_U] WHEN "R" THEN [safe_R] ELSE [safe_T] END' />
            </column>
            <column caption="Accès sûr rural" datatype='real' name="[safe_R]" role='measure' type='quantitative' />
            <column caption="Accès sûr total" datatype='real' name="[safe_T]" role='measure' type='quantitative' />
            <column caption="Accès sûr urbain" datatype='real' name="[safe_U]" role='measure' type='quantitative' />
            <column caption="Stabilité politique" datatype='real' name="[stability]" role='measure' type='quantitative' />
            <column caption="Population de la zone" datatype='real' name="[w_zone]" role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [zone_code] WHEN "U" THEN [pop_urb] WHEN "R" THEN [pop_rur] ELSE [pop] END' />
            </column>
            <column caption="Année" datatype='integer' name="[year]" role='dimension' type='ordinal' />
            <column caption="Code zone" datatype='string' name="[zone_code]" role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2] WHEN "Urbain" THEN "U" WHEN "Rural" THEN "R" ELSE "T" END' />
            </column>
            <column-instance column="[f_annee]" derivation='None' name="[none:f_annee:nk]" pivot='key' type='nominal' />
            <column-instance column="[f_continent]" derivation='None' name="[none:f_continent:nk]" pivot='key' type='nominal' />
            <column-instance column="[f_retenu]" derivation='None' name="[none:f_retenu:nk]" pivot='key' type='nominal' />
            <column-instance column="[ks_safe]" derivation='User' name="[usr:ks_safe:nk]" pivot='key' type='nominal' />
            <column-instance column="[kv_safe]" derivation='User' name="[usr:kv_safe:nk]" pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column="[pays_annee].[none:f_annee:nk]">
            <groupfilter function='member' level="[none:f_annee:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column="[pays_annee].[none:f_retenu:nk]">
            <groupfilter function='member' level="[none:f_retenu:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column="[pays_annee].[none:f_continent:nk]">
            <groupfilter function='member' level="[none:f_continent:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[pays_annee].[none:f_annee:nk]</column>
            <column>[pays_annee].[none:f_retenu:nk]</column>
            <column>[pays_annee].[none:f_continent:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
        </style>
        <panes>
          <pane>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Text' />
            <encodings>
              <text column="[pays_annee].[usr:kv_safe:nk]" />
              <tooltip column="[pays_annee].[usr:ks_safe:nk]" />
            </encodings>
            <customized-label>
              <formatted-text>
                <run fontcolor='#5f7488' fontsize='9' bold='true'>ACCÈS SÛR
</run>
                <run fontcolor='#0b2236' fontsize='20' bold='true'>&lt;[pays_annee].[usr:kv_safe:nk]&gt;
</run>
                <run fontcolor='#5f7488' fontsize='8'>&lt;[pays_annee].[usr:ks_safe:nk]&gt;</run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows></rows>
        <cols></cols>
      </table>
    </worksheet>
    <worksheet name="Continent · KPI Sans accès basique">
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#0b2236' fontsize='11'>Sans accès basique</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Pays × année" name="pays_annee" />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption="Année" datatype='integer' name="[Parameter 1]" param-domain-type='range' role='measure' type='quantitative' value="2017">
              <calculation class='tableau' formula="2017" />
              <range granularity='1' max='2017' min='2000' />
            </column>
            <column caption="Stabilité politique minimale" datatype='real' name="[Parameter 3]" param-domain-type='range' role='measure' type='quantitative' value="-3.5">
              <calculation class='tableau' formula="-3.5" />
              <range granularity='0.1' max='1.5' min='-3.5' />
            </column>
            <column caption="Continent (région OMS)" datatype='string' name="[Parameter 4]" param-domain-type='list' role='measure' type='nominal' value='"Afrique"'>
              <calculation class='tableau' formula='"Afrique"' />
              <members>
                <member value='"Afrique"' />
                <member value='"Amériques"' />
                <member value='"Asie du Sud-Est"' />
                <member value='"Europe"' />
                <member value='"Méditerranée orientale"' />
                <member value='"Pacifique occidental"' />
              </members>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource="pays_annee">
            <column caption="Continent" datatype='string' name="[continent]" role='dimension' type='nominal' />
            <column caption="Année choisie" datatype='boolean' name="[f_annee]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="[year] = [Parameters].[Parameter 1]" />
            </column>
            <column caption="Dans le continent choisi" datatype='boolean' name="[f_continent]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="[continent] = [Parameters].[Parameter 4]" />
            </column>
            <column caption="Retenu (stabilité)" datatype='boolean' name="[f_retenu]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="ISNULL([stability]) OR [stability] &gt;= [Parameters].[Parameter 3]" />
            </column>
            <column caption="Code pays" datatype='string' name="[iso3]" role='dimension' type='nominal' semantic-role='[Country].[ISO3166_3]' />
            <column caption="KPI Sans accès basique (détail)" datatype='string' name="[ks_sans]" role='measure' type='nominal'>
              <calculation class='tableau' formula='IF COUNT([iso3]) &gt; 0 THEN "personnes (total)" END' />
            </column>
            <column caption="KPI Sans accès basique" datatype='string' name="[kv_sans]" role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL(SUM([pop_without_basic])) THEN "n.d." ELSEIF SUM([pop_without_basic]) &gt;= 1e9 THEN REPLACE(STR(ROUND(SUM([pop_without_basic])/1e9, 2)), ".", ",") + " Md" ELSEIF SUM([pop_without_basic]) &gt;= 1e6 THEN REPLACE(STR(ROUND(SUM([pop_without_basic])/1e6, 1)), ".", ",") + " M" ELSEIF SUM([pop_without_basic]) &gt;= 1e3 THEN STR(INT(ROUND(SUM([pop_without_basic])/1e3, 0))) + " k" ELSE STR(INT(ROUND(SUM([pop_without_basic]), 0))) END' />
            </column>
            <column caption="Personnes sans accès basique" datatype='real' name="[pop_without_basic]" role='measure' type='quantitative' />
            <column caption="Stabilité politique" datatype='real' name="[stability]" role='measure' type='quantitative' />
            <column caption="Année" datatype='integer' name="[year]" role='dimension' type='ordinal' />
            <column-instance column="[f_annee]" derivation='None' name="[none:f_annee:nk]" pivot='key' type='nominal' />
            <column-instance column="[f_continent]" derivation='None' name="[none:f_continent:nk]" pivot='key' type='nominal' />
            <column-instance column="[f_retenu]" derivation='None' name="[none:f_retenu:nk]" pivot='key' type='nominal' />
            <column-instance column="[ks_sans]" derivation='User' name="[usr:ks_sans:nk]" pivot='key' type='nominal' />
            <column-instance column="[kv_sans]" derivation='User' name="[usr:kv_sans:nk]" pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column="[pays_annee].[none:f_annee:nk]">
            <groupfilter function='member' level="[none:f_annee:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column="[pays_annee].[none:f_retenu:nk]">
            <groupfilter function='member' level="[none:f_retenu:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column="[pays_annee].[none:f_continent:nk]">
            <groupfilter function='member' level="[none:f_continent:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[pays_annee].[none:f_annee:nk]</column>
            <column>[pays_annee].[none:f_retenu:nk]</column>
            <column>[pays_annee].[none:f_continent:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
        </style>
        <panes>
          <pane>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Text' />
            <encodings>
              <text column="[pays_annee].[usr:kv_sans:nk]" />
              <tooltip column="[pays_annee].[usr:ks_sans:nk]" />
            </encodings>
            <customized-label>
              <formatted-text>
                <run fontcolor='#5f7488' fontsize='9' bold='true'>SANS ACCÈS BASIQUE
</run>
                <run fontcolor='#0b2236' fontsize='20' bold='true'>&lt;[pays_annee].[usr:kv_sans:nk]&gt;
</run>
                <run fontcolor='#5f7488' fontsize='8'>&lt;[pays_annee].[usr:ks_sans:nk]&gt;</run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows></rows>
        <cols></cols>
      </table>
    </worksheet>
    <worksheet name="Continent · KPI Mortalité WASH 2016">
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#0b2236' fontsize='11'>Mortalité WASH 2016</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Pays × année" name="pays_annee" />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption="Année" datatype='integer' name="[Parameter 1]" param-domain-type='range' role='measure' type='quantitative' value="2017">
              <calculation class='tableau' formula="2017" />
              <range granularity='1' max='2017' min='2000' />
            </column>
            <column caption="Stabilité politique minimale" datatype='real' name="[Parameter 3]" param-domain-type='range' role='measure' type='quantitative' value="-3.5">
              <calculation class='tableau' formula="-3.5" />
              <range granularity='0.1' max='1.5' min='-3.5' />
            </column>
            <column caption="Continent (région OMS)" datatype='string' name="[Parameter 4]" param-domain-type='list' role='measure' type='nominal' value='"Afrique"'>
              <calculation class='tableau' formula='"Afrique"' />
              <members>
                <member value='"Afrique"' />
                <member value='"Amériques"' />
                <member value='"Asie du Sud-Est"' />
                <member value='"Europe"' />
                <member value='"Méditerranée orientale"' />
                <member value='"Pacifique occidental"' />
              </members>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource="pays_annee">
            <column caption="Continent" datatype='string' name="[continent]" role='dimension' type='nominal' />
            <column caption="Décès WASH 2016" datatype='real' name="[deaths_2016]" role='measure' type='quantitative' />
            <column caption="Année choisie" datatype='boolean' name="[f_annee]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="[year] = [Parameters].[Parameter 1]" />
            </column>
            <column caption="Dans le continent choisi" datatype='boolean' name="[f_continent]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="[continent] = [Parameters].[Parameter 4]" />
            </column>
            <column caption="Retenu (stabilité)" datatype='boolean' name="[f_retenu]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="ISNULL([stability]) OR [stability] &gt;= [Parameters].[Parameter 3]" />
            </column>
            <column caption="KPI Mortalité WASH 2016 (détail)" datatype='string' name="[ks_mort]" role='measure' type='nominal'>
              <calculation class='tableau' formula='"pour 100 000 hab. · " + IF ISNULL(SUM([deaths_2016])) THEN "0" ELSEIF SUM([deaths_2016]) &gt;= 1e9 THEN REPLACE(STR(ROUND(SUM([deaths_2016])/1e9, 2)), ".", ",") + " Md" ELSEIF SUM([deaths_2016]) &gt;= 1e6 THEN REPLACE(STR(ROUND(SUM([deaths_2016])/1e6, 1)), ".", ",") + " M" ELSEIF SUM([deaths_2016]) &gt;= 1e3 THEN STR(INT(ROUND(SUM([deaths_2016])/1e3, 0))) + " k" ELSE STR(INT(ROUND(SUM([deaths_2016]), 0))) END + " décès"' />
            </column>
            <column caption="KPI Mortalité WASH 2016" datatype='string' name="[kv_mort]" role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([m_mort]) THEN "n.d." ELSE REPLACE(STR(ROUND([m_mort], 1)), ".", ",") END' />
            </column>
            <column caption="Mortalité WASH 2016 (pour 100 000)" datatype='real' name="[m_mort]" role='measure' type='quantitative'>
              <calculation class='tableau' formula="SUM([deaths_2016]) / SUM(IF NOT ISNULL([deaths_2016]) THEN [pop_2016] END) * 100000" />
            </column>
            <column caption="Population 2016" datatype='real' name="[pop_2016]" role='measure' type='quantitative' />
            <column caption="Stabilité politique" datatype='real' name="[stability]" role='measure' type='quantitative' />
            <column caption="Année" datatype='integer' name="[year]" role='dimension' type='ordinal' />
            <column-instance column="[f_annee]" derivation='None' name="[none:f_annee:nk]" pivot='key' type='nominal' />
            <column-instance column="[f_continent]" derivation='None' name="[none:f_continent:nk]" pivot='key' type='nominal' />
            <column-instance column="[f_retenu]" derivation='None' name="[none:f_retenu:nk]" pivot='key' type='nominal' />
            <column-instance column="[ks_mort]" derivation='User' name="[usr:ks_mort:nk]" pivot='key' type='nominal' />
            <column-instance column="[kv_mort]" derivation='User' name="[usr:kv_mort:nk]" pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column="[pays_annee].[none:f_annee:nk]">
            <groupfilter function='member' level="[none:f_annee:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column="[pays_annee].[none:f_retenu:nk]">
            <groupfilter function='member' level="[none:f_retenu:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column="[pays_annee].[none:f_continent:nk]">
            <groupfilter function='member' level="[none:f_continent:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[pays_annee].[none:f_annee:nk]</column>
            <column>[pays_annee].[none:f_retenu:nk]</column>
            <column>[pays_annee].[none:f_continent:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
        </style>
        <panes>
          <pane>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Text' />
            <encodings>
              <text column="[pays_annee].[usr:kv_mort:nk]" />
              <tooltip column="[pays_annee].[usr:ks_mort:nk]" />
            </encodings>
            <customized-label>
              <formatted-text>
                <run fontcolor='#5f7488' fontsize='9' bold='true'>MORTALITÉ WASH 2016
</run>
                <run fontcolor='#0b2236' fontsize='20' bold='true'>&lt;[pays_annee].[usr:kv_mort:nk]&gt;
</run>
                <run fontcolor='#5f7488' fontsize='8'>&lt;[pays_annee].[usr:ks_mort:nk]&gt;</run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows></rows>
        <cols></cols>
      </table>
    </worksheet>
