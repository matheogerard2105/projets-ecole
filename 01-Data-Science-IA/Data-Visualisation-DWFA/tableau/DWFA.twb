              <members>
                <member value='"Total"' />
                <member value='"Urbain"' />
                <member value='"Rural"' />
              </members>
            </column>
            <column caption="Stabilité politique minimale" datatype='real' name="[Parameter 3]" param-domain-type='range' role='measure' type='quantitative' value="-3.5">
