            <column caption="Année choisie" datatype='boolean' name="[f_annee]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="[year] = [Parameters].[Parameter 1]" />
            </column>
            <column caption="Dans le continent choisi" datatype='boolean' name="[f_continent]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="[continent] = [Parameters].[Parameter 4]" />
            </column>
