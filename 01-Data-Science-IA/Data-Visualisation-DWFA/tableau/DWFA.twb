          <datasource-dependencies datasource="indicateurs">
            <column caption="Continent du pays choisi" datatype='string' name="[cont_pays]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="{FIXED : MAX(IF [pays] = [Parameters].[Parameter 5] THEN [continent] END)}" />
            </column>
            <column caption="Continent" datatype='string' name="[continent]" role='dimension' type='nominal' />
            <column caption="Dans le continent du pays choisi" datatype='boolean' name="[f_cont_pays]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="[continent] = [cont_pays]" />
            </column>
            <column caption="Pays choisi" datatype='boolean' name="[f_pays]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="[pays] = [Parameters].[Parameter 5]" />
            </column>
            <column caption="Stabilité pays / continent" datatype='boolean' name="[f_stab]" role='dimension' type='nominal'>
              <calculation class='tableau' formula='[indicateur] = "Stabilité" AND (([niveau] = "Pays" AND [f_pays]) OR ([niveau] = "Continent" AND [f_cont_pays]))' />
            </column>
            <column caption="Indicateur" datatype='string' name="[indicateur]" role='dimension' type='nominal' />
            <column caption="Valeur pondérée" datatype='real' name="[m_val]" role='measure' type='quantitative'>
              <calculation class='tableau' formula="SUM(IF NOT ISNULL([valeur]) AND NOT ISNULL([poids]) THEN [valeur] * [poids] END) / SUM(IF NOT ISNULL([valeur]) AND NOT ISNULL([poids]) THEN [poids] END)" />
            </column>
            <column caption="Niveau" datatype='string' name="[niveau]" role='dimension' type='nominal' />
            <column caption="Pays" datatype='string' name="[pays]" role='dimension' type='nominal' />
            <column caption="Poids" datatype='real' name="[poids]" role='measure' type='quantitative' />
            <column caption="Valeur" datatype='real' name="[valeur]" role='measure' type='quantitative' />
            <column caption="Année" datatype='integer' name="[year]" role='dimension' type='ordinal' />
            <column-instance column="[f_stab]" derivation='None' name="[none:f_stab:nk]" pivot='key' type='nominal' />
            <column-instance column="[niveau]" derivation='None' name="[none:niveau:nk]" pivot='key' type='nominal' />
            <column-instance column="[year]" derivation='None' name="[none:year:ok]" pivot='key' type='ordinal' />
            <column-instance column="[m_val]" derivation='User' name="[usr:m_val:qk]" pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column="[indicateurs].[none:f_stab:nk]">
            <groupfilter function='member' level="[none:f_stab:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[indicateurs].[none:f_stab:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='title' class='0' field="[indicateurs].[usr:m_val:qk]" scope='rows' value="indice (-2,5 à +2,5)" />
          </style-rule>
        </style>
