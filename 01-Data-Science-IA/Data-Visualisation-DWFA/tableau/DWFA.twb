            <style>
              <style-rule element='mark'>
                <format attr='mark-color' value='#2a78d6' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[pays_annee].[avg:safe_T:qk]</rows>
        <cols>[pays_annee].[avg:basic_T:qk]</cols>
      </table>
