            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Circle' />
            <encodings>
              <size column="[pays_annee].[sum:pop_without_basic:qk]" />
              <lod column="[pays_annee].[none:iso3:nk]" />
              <lod column="[pays_annee].[none:pays:nk]" />
              <tooltip column="[pays_annee].[sum:pop_without_basic:qk]" />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='mark-color' value='#2a78d6' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[pays_annee].[avg:basic_T:qk]</rows>
        <cols>[pays_annee].[avg:urban_rate:qk]</cols>
      </table>
    </worksheet>
