            <format attr='title' class='0' field="[pays_annee].[avg:safe_T:qk]" scope='rows' value="Accès sûr (%)" />
            <format attr='title' class='0' field="[pays_annee].[avg:basic_T:qk]" scope='cols' value="Accès basique (%)" />
          </style-rule>
        </style>
        <panes>
          <pane>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Circle' />
            <encodings>
              <lod column="[pays_annee].[none:iso3:nk]" />
              <lod column="[pays_annee].[none:pays:nk]" />
