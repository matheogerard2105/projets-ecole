                <member value='"Îles Marshall"' />
              </members>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource="pays_annee">
            <column caption="Décès WASH 2016" datatype='real' name="[deaths_2016]" role='measure' type='quantitative' />
            <column caption="Année choisie" datatype='boolean' name="[f_annee]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="[year] = [Parameters].[Parameter 1]" />
            </column>
            <column caption="Pays choisi" datatype='boolean' name="[f_pays]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="[pays] = [Parameters].[Parameter 5]" />
            </column>
            <column caption="KPI Mortalité WASH 2016 (détail)" datatype='string' name="[ks_mort]" role='measure' type='nominal'>
              <calculation class='tableau' formula='"pour 100 000 hab. · " + IF ISNULL(SUM([deaths_2016])) THEN "0" ELSEIF SUM([deaths_2016]) &gt;= 1e9 THEN REPLACE(STR(ROUND(SUM([deaths_2016])/1e9, 2)), ".", ",") + " Md" ELSEIF SUM([deaths_2016]) &gt;= 1e6 THEN REPLACE(STR(ROUND(SUM([deaths_2016])/1e6, 1)), ".", ",") + " M" ELSEIF SUM([deaths_2016]) &gt;= 1e3 THEN STR(INT(ROUND(SUM([deaths_2016])/1e3, 0))) + " k" ELSE STR(INT(ROUND(SUM([deaths_2016]), 0))) END + " décès"' />
            </column>
            <column caption="KPI Mortalité WASH 2016" datatype='string' name="[kv_mort]" role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([m_mort]) THEN "n.d." ELSE REPLACE(STR(ROUND([m_mort], 1)), ".", ",") END' />
            </column>
            <column caption="Mortalité WASH 2016 (pour 100 000)" datatype='real' name="[m_mort]" role='measure' type='quantitative'>
              <calculation class='tableau' formula="SUM([deaths_2016]) / SUM(IF NOT ISNULL([deaths_2016]) THEN [pop_2016] END) * 100000" />
            </column>
            <column caption="Pays" datatype='string' name="[pays]" role='dimension' type='nominal' />
            <column caption="Population 2016" datatype='real' name="[pop_2016]" role='measure' type='quantitative' />
            <column caption="Année" datatype='integer' name="[year]" role='dimension' type='ordinal' />
            <column-instance column="[f_annee]" derivation='None' name="[none:f_annee:nk]" pivot='key' type='nominal' />
            <column-instance column="[f_pays]" derivation='None' name="[none:f_pays:nk]" pivot='key' type='nominal' />
            <column-instance column="[ks_mort]" derivation='User' name="[usr:ks_mort:nk]" pivot='key' type='nominal' />
            <column-instance column="[kv_mort]" derivation='User' name="[usr:kv_mort:nk]" pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column="[pays_annee].[none:f_annee:nk]">
            <groupfilter function='member' level="[none:f_annee:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column="[pays_annee].[none:f_pays:nk]">
            <groupfilter function='member' level="[none:f_pays:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[pays_annee].[none:f_annee:nk]</column>
            <column>[pays_annee].[none:f_pays:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
        </style>
        <panes>
          <pane>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Text' />
            <encodings>
              <text column="[pays_annee].[usr:kv_mort:nk]" />
              <tooltip column="[pays_annee].[usr:ks_mort:nk]" />
            </encodings>
            <customized-label>
              <formatted-text>
                <run fontcolor='#5f7488' fontsize='9' bold='true'>MORTALITÉ WASH 2016
</run>
                <run fontcolor='#0b2236' fontsize='20' bold='true'>&lt;[pays_annee].[usr:kv_mort:nk]&gt;
</run>
                <run fontcolor='#5f7488' fontsize='8'>&lt;[pays_annee].[usr:ks_mort:nk]&gt;</run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows></rows>
        <cols></cols>
      </table>
    </worksheet>
