          </datasource-dependencies>
          <datasource-dependencies datasource="pays_annee">
            <column caption="Continent du pays choisi" datatype='string' name="[cont_pays]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="{FIXED : MAX(IF [pays] = [Parameters].[Parameter 5] THEN [continent] END)}" />
            </column>
            <column caption="Continent" datatype='string' name="[continent]" role='dimension' type='nominal' />
            <column caption="Score d'efficacité" datatype='real' name="[efficiency_score]" role='measure' type='quantitative' />
            <column caption="Année 2016" datatype='boolean' name="[f_2016]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="[year] = 2016" />
            </column>
            <column caption="Dans le continent du pays choisi" datatype='boolean' name="[f_cont_pays]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="[continent] = [cont_pays]" />
            </column>
            <column caption="Pays choisi" datatype='boolean' name="[f_pays]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="[pays] = [Parameters].[Parameter 5]" />
            </column>
            <column caption="Code pays" datatype='string' name="[iso3]" role='dimension' type='nominal' semantic-role='[Country].[ISO3166_3]' />
            <column caption="Libellé pays choisi" datatype='string' name="[lab_sel]" role='dimension' type='nominal'>
              <calculation class='tableau' formula="IF [f_pays] THEN [pays] END" />
            </column>
            <column caption="Mortalité WASH 2016" datatype='real' name="[mortality_2016]" role='measure' type='quantitative' />
            <column caption="Pays" datatype='string' name="[pays]" role='dimension' type='nominal' />
            <column caption="Stabilité politique 2016" datatype='real' name="[stability_2016]" role='measure' type='quantitative' />
            <column caption="Année" datatype='integer' name="[year]" role='dimension' type='ordinal' />
            <column-instance column="[efficiency_score]" derivation='Avg' name="[avg:efficiency_score:qk]" pivot='key' type='quantitative' />
            <column-instance column="[mortality_2016]" derivation='Avg' name="[avg:mortality_2016:qk]" pivot='key' type='quantitative' />
            <column-instance column="[stability_2016]" derivation='Avg' name="[avg:stability_2016:qk]" pivot='key' type='quantitative' />
            <column-instance column="[f_2016]" derivation='None' name="[none:f_2016:nk]" pivot='key' type='nominal' />
            <column-instance column="[f_cont_pays]" derivation='None' name="[none:f_cont_pays:nk]" pivot='key' type='nominal' />
            <column-instance column="[f_pays]" derivation='None' name="[none:f_pays:nk]" pivot='key' type='nominal' />
            <column-instance column="[iso3]" derivation='None' name="[none:iso3:nk]" pivot='key' type='nominal' />
            <column-instance column="[lab_sel]" derivation='None' name="[none:lab_sel:nk]" pivot='key' type='nominal' />
            <column-instance column="[pays]" derivation='None' name="[none:pays:nk]" pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column="[pays_annee].[none:f_cont_pays:nk]">
            <groupfilter function='member' level="[none:f_cont_pays:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column="[pays_annee].[none:f_2016:nk]">
            <groupfilter function='member' level="[none:f_2016:nk]" member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[pays_annee].[none:f_cont_pays:nk]</column>
            <column>[pays_annee].[none:f_2016:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='title' class='0' field="[pays_annee].[avg:efficiency_score:qk]" scope='rows' value="Score d'efficacité (0-100)" />
            <format attr='title' class='0' field="[pays_annee].[avg:stability_2016:qk]" scope='cols' value="Stabilité politique 2016" />
          </style-rule>
        </style>
        <panes>
          <pane>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Circle' />
            <encodings>
              <color column="[pays_annee].[none:f_pays:nk]" />
              <text column="[pays_annee].[none:lab_sel:nk]" />
              <lod column="[pays_annee].[none:iso3:nk]" />
              <lod column="[pays_annee].[none:pays:nk]" />
              <tooltip column="[pays_annee].[avg:mortality_2016:qk]" />
            </encodings>
            <style>
              <style-rule element='mark'>
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[pays_annee].[avg:efficiency_score:qk]</rows>
        <cols>[pays_annee].[avg:stability_2016:qk]</cols>
      </table>
    </worksheet>
  </worksheets>
